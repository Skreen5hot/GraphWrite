            "before": "import { useMemo, useCallback, type MouseEvent as ReactMouseEvent } from \"react\";\nimport {\n  ReactFlow,\n  ReactFlowProvider,\n  Background,\n  Controls,\n  useReactFlow,\n  MarkerType,\n  type Node,\n  type Edge,\n  type Connection,\n} from \"@xyflow/react\";",
