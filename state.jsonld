            "rationale": "Add 'owl:AnnotationProperty' to VALID_TYPES set so AC3 per-entry type check accepts the new type without false failures.",
            "before": "const VALID_TYPES: ReadonlySet<EcmTermType> = new Set([\n  \"owl:Class\",\n  \"owl:ObjectProperty\",\n  \"owl:DatatypeProperty\",\n]);",
            "after": "const VALID_TYPES: ReadonlySet<EcmTermType> = new Set([\n  \"owl:Class\",\n  \"owl:ObjectProperty\",\n  \"owl:DatatypeProperty\",\n  \"owl:AnnotationProperty\",\n]);",
            "scope": "minimal"
