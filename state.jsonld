            "before": "/** Returns the last non-empty segment of an IRI, split on /, #, :, or -. */\nfunction iriTail(iri: string): string {\n  const parts = iri.split(/[-#/:]/).filter((s) => s.length > 0);\n  return parts[parts.length - 1] ?? iri;\n}\n\nfunction deriveNodes(project: Record<string, unknown>): InstanceNode[] {",
