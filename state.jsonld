    {
      "@id": "urn:fnsr:task:482-dev-r5b-add-annotation",
      "agent": "developer",
      "status": "done",
      "priority": 10,
      "depends_on": [
        "urn:fnsr:task:481-test-r5-c7-v5",
        "urn:fnsr:task:459-rat-r5-c3-v5"
      ],
      "inputs": {
        "round": "5b",
        "chain_label": "R5b-1: Add Annotation button (parallel to existing Add literal button)",
        "item_ids": [
          "R5b-1"
        ],
        "purpose": "Add an 'Add Annotation' button to the Annotation Assertion section of Inspector.tsx, mirroring the existing 'Add literal' button in the DataType Assertion section. Aaron 2026-05-25 testing: 'there is NO way to add another Annotation Assertion there should be an Add Annotation button.' This completes the symmetry that Chain 3's R5-A3 split established. Pure UX follow-up; no ontology semantics change.",
        "files_in_scope": [
          "src/ui/Inspector.tsx",
          "src/ui/App.tsx",
          "src/composition/"
        ],
        "constraint": "Mirror the existing 'Add literal' affordance: button at the bottom of the section; clicking opens (or inline-reveals) a form for picking which annotation property (rdfs:label / rdfs:comment / rdfs:seeAlso / user-created annotation properties from the Term Sidebar Annotation Properties section) + the value. Use the SAME shape as literal-add but route to the owl:AnnotationProperty assertion path in the underlying data model. Determinism MUST be preserved (no live timestamps in newly-created assertions). Per Spec 03 brief-confirmation pattern: this completes the symmetry the architect ratified at 459-rat-r5-c3-v5 \u2014 no fresh ratification needed.",
        "spec_refs": [
          "FNSR Spec 03 \u00a7Brief-confirmation chain",
          "Round 5 R5-A3 architect ratification 459-rat-r5-c3-v5 (parent ratification)"
        ]
      },
      "attempts": 1,
      "outputs": {
        "changes": [
          {
            "id": "C1",
            "file": "src/ui/AddAnnotationDialog.tsx",
            "rationale": "New dialog component mirroring AddLiteralDialog.tsx exactly \u00e2\u20ac\u201d same form fields (property, value, datatype, language tag), same ecm:LiteralAssertion output shape, same crypto.randomUUID() ID generation \u00e2\u20ac\u201d but populating the property dropdown from owl:AnnotationProperty terms (with STARTER_TERMS fallback per the Inspector's getAnnotationPropertyOptions pattern) instead of owl:DatatypeProperty terms. Distinct testIds (gw-dialog-add-annotation, gw-form-add-annotation, gw-select-annotation-predicate, etc.) preserve testability separation from the literal dialog.",
            "before": null,
            "after": "/**\n * AddAnnotationDialog -- form for adding owl:AnnotationProperty assertions.\n *\n * Produces an ecm:LiteralAssertion routed to the AnnotationAssertion section\n * per OWL 2 DL axiom-type partition (R5-A3 / ratification 459-rat-r5-c3-v5).\n * Literal-assertion shape: SPEC section 5.10.\n * IRI generation: uses crypto.randomUUID() (Web Crypto API; browser-native;\n * typed in tsconfig.ui.json lib:DOM).\n */\n\nimport { useState, type FormEvent } from \"react\";\nimport { Dialog } from \"./Dialog.js\";\nimport { iriTail, resolveTermLabel } from \"./label-resolution.js\";\nimport { STARTER_TERMS } from \"../validate/starter-terms.js\";\n\n/** Allowed Phase 2 datatypes per SPEC section 5.10. */\nconst DATATYPE_OPTIONS = [\n  \"xsd:string\",\n  \"xsd:boolean\",\n  \"xsd:integer\",\n  \"xsd:decimal\",\n  \"xsd:double\",\n  \"xsd:date\",\n  \"xsd:dateTime\",\n  \"xsd:anyURI\",\n  \"rdf:langString\",\n] as const;\n\ninterface AnnotationPropOption {\n  iri: string;\n  label: string;\n}\n\ninterface AddAnnotationDialogProps {\n  /** The project document; used to extract owl:AnnotationProperty terms. */\n  project: Record<string, unknown>;\n  /** IRI of the ecm:Instance this assertion attaches to (ecm:subjectIri). */\n  subjectIri: string;\n  /** Called with the new SPEC section 5.10-shaped ecm:LiteralAssertion on submit. */\n  onConfirm: (newAssertion: Record<string, unknown>) => void;\n  onClose: () => void;\n}\n\n/**\n * Extract owl:AnnotationProperty options from ecm:terms with STARTER_TERMS fallback.\n * Mirrors getAnnotationPropertyOptions() in Inspector.tsx; kept local per the\n * AddLiteralDialog pattern (self-contained option computation from project).\n */\nfunction getAnnotationPropertyOptions(\n  project: Record<string, unknown>,\n): AnnotationPropOption[] {\n  const raw = project[\"ecm:terms\"];\n  const seen = new Set<string>();\n  const result: AnnotationPropOption[] = [];\n  if (Array.isArray(raw)) {\n    for (const item of raw as unknown[]) {\n      if (typeof item !== \"object\" || item === null) continue;\n      const obj = item as Record<string, unknown>;\n      if (typeof obj[\"id\"] !== \"string\") continue;\n      if (obj[\"type\"] !== \"owl:AnnotationProperty\") continue;\n      const iri = obj[\"id\"] as string;\n      seen.add(iri);\n      const labelText = resolveTermLabel(obj[\"rdfs:label\"]);\n      const label = labelText.length > 0 ? labelText : iriTail(iri);\n      result.push({ iri, label });\n    }\n  }\n  // Fallback: include STARTER_TERMS annotation properties not already in ecm:terms.\n  for (const st of STARTER_TERMS) {\n    if (st.type === \"owl:AnnotationProperty\" && !seen.has(st.id)) {\n      const labelText = resolveTermLabel(st[\"rdfs:label\"]);\n      const label = labelText.length > 0 ? labelText : iriTail(st.id);\n      result.push({ iri: st.id, label });\n    }\n  }\n  return result;\n}\n\nexport function AddAnnotationDialog({\n  project,\n  subjectIri,\n  onConfirm,\n  onClose,\n}: AddAnnotationDialogProps) {\n  const annPropOptions = getAnnotationPropertyOptions(project);\n  const [predicateIri, setPredicateIri] = useState(annPropOptions[0]?.iri ?? \"\");\n  const [value, setValue] = useState(\"\");\n  const [language, setLanguage] = useState(\"\");\n  const [datatype, setDatatype] = useState<string>(\"xsd:string\");\n  const [error, setError] = useState<string | null>(null);\n\n  function handleSubmit(e: FormEvent<HTMLFormElement>) {\n    e.preventDefault();\n    if (predicateIri.length === 0) {\n      setError(\n        \"No owl:AnnotationProperty terms in this project. Add one via the Term Manager first.\",\n      );\n      return;\n    }\n    const trimmedValue = value.trim();\n    if (trimmedValue.length === 0) {\n      setError(\"Value is required.\");\n      return;\n    }\n    const trimmedLang = language.trim();\n    const newAssertion: Record<string, unknown> = {\n      \"ecm:datatype\": datatype,\n      \"ecm:language\": trimmedLang.length > 0 ? trimmedLang : null,\n      \"ecm:predicateIri\": predicateIri,\n      \"ecm:subjectIri\": subjectIri,\n      \"ecm:value\": trimmedValue,\n      id: `urn:uuid:${crypto.randomUUID()}`,\n      type: \"ecm:LiteralAssertion\",\n    };\n    onConfirm(newAssertion);\n  }\n\n  return (\n    <Dialog title=\"Add Annotation\" onClose={onClose} testId=\"gw-dialog-add-annotation\">\n      <form\n        className=\"gw-term-form\"\n        onSubmit={handleSubmit}\n        data-testid=\"gw-form-add-annotation\"\n      >\n        {error !== null && (\n          <p className=\"gw-form-error\" role=\"alert\" data-testid=\"gw-form-error\">\n            {error}\n          </p>\n        )}\n        <label className=\"gw-form-label\">\n          Property *\n          <select\n            className=\"gw-form-input\"\n            value={predicateIri}\n            onChange={(e) => {\n              setPredicateIri(e.target.value);\n              setError(null);\n            }}\n            data-testid=\"gw-select-annotation-predicate\"\n          >\n            {annPropOptions.length === 0 && (\n              <option value=\"\">(no annotation properties available)</option>\n            )}\n            {annPropOptions.map((opt) => (\n              <option key={opt.iri} value={opt.iri}>\n                {opt.label}\n              </option>\n            ))}\n          </select>\n        </label>\n        <label className=\"gw-form-label\">\n          Value *\n          <input\n            className=\"gw-form-input\"\n            type=\"text\"\n            value={value}\n            onChange={(e) => {\n              setValue(e.target.value);\n              setError(null);\n            }}\n            data-testid=\"gw-input-annotation-value\"\n            autoFocus\n          />\n        </label>\n        <label className=\"gw-form-label\">\n          Datatype\n          <select\n            className=\"gw-form-input\"\n            value={datatype}\n            onChange={(e) => { setDatatype(e.target.value); }}\n            data-testid=\"gw-select-annotation-datatype\"\n          >\n            {DATATYPE_OPTIONS.map((dt) => (\n              <option key={dt} value={dt}>\n                {dt}\n              </option>\n            ))}\n          </select>\n        </label>\n        <label className=\"gw-form-label\">\n          Language tag{\" \"}\n          <span className=\"gw-form-hint\">(optional; e.g. en)</span>\n          <input\n            className=\"gw-form-input\"\n            type=\"text\"\n            value={language}\n            onChange={(e) => { setLanguage(e.target.value); }}\n            data-testid=\"gw-input-annotation-language\"\n          />\n        </label>\n        <div className=\"gw-form-actions\">\n          <button\n            type=\"button\"\n            className=\"gw-btn gw-btn--secondary\"\n            onClick={onClose}\n            data-testid=\"gw-btn-annotation-cancel\"\n          >\n            Cancel\n          </button>\n          <button\n            type=\"submit\"\n            className=\"gw-btn\"\n            disabled={annPropOptions.length === 0}\n            data-testid=\"gw-btn-annotation-submit\"\n          >\n            Add Annotation\n          </button>\n        </div>\n      </form>\n    </Dialog>\n  );\n}\n",
            "scope": "minimal"
          },
          {
            "id": "C2a",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Import the new AddAnnotationDialog alongside AddLiteralDialog.",
            "before": "import { AddLiteralDialog } from \"./AddLiteralDialog.js\";",
            "after": "import { AddLiteralDialog } from \"./AddLiteralDialog.js\";\nimport { AddAnnotationDialog } from \"./AddAnnotationDialog.js\";",
            "scope": "minimal"
          },
          {
            "id": "C2b",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Add addAnnotationOpen state variable parallel to addLiteralOpen. Both control their respective dialog open/close.",
            "before": "  const [addLiteralOpen, setAddLiteralOpen] = useState(false);\n  const [deleteInstanceConfirmOpen, setDeleteInstanceConfirmOpen] = useState(false);",
            "after": "  const [addLiteralOpen, setAddLiteralOpen] = useState(false);\n  const [addAnnotationOpen, setAddAnnotationOpen] = useState(false);\n  const [deleteInstanceConfirmOpen, setDeleteInstanceConfirmOpen] = useState(false);",
            "scope": "minimal"
          },
          {
            "id": "C2c",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Insert 'Add Annotation' button at the bottom of the Annotation Assertions section, immediately before the DataType Assertions section comment. Mirrors the 'Add literal' button placement at the bottom of the DataType Assertions section (gw-btn-add-literal). Uses the same style (marginTop 0.5rem, width 100%) for visual symmetry.",
            "before": "          {/* ---- DataType Assertions (owl:DatatypeProperty axioms; participate in datatype reasoning) ---- */}",
            "after": "          <button\n            type=\"button\"\n            data-testid=\"gw-btn-add-annotation\"\n            onClick={() => { setAddAnnotationOpen(true); }}\n            style={{ marginTop: \"0.5rem\", width: \"100%\" }}\n          >\n            Add Annotation\n          </button>\n          {/* ---- DataType Assertions (owl:DatatypeProperty axioms; participate in datatype reasoning) ---- */}",
            "scope": "minimal"
          },
          {
            "id": "C2d",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Render AddAnnotationDialog conditionally on addAnnotationOpen, directly after the AddLiteralDialog block. The onConfirm handler is identical to the literal handler \u00e2\u20ac\u201d both append to ecm:literalAssertions \u00e2\u20ac\u201d because the data model for annotation assertions is also ecm:LiteralAssertion (partitioned at render time by termTypeMap, not at storage time).",
            "before": "        {addLiteralOpen && (\n          <AddLiteralDialog\n            project={project}\n            subjectIri={selectedInstanceId}\n            onConfirm={(newAssertion) => {\n              if (onProjectChange !== undefined && project !== null) {\n                const existing = Array.isArray(project[\"ecm:literalAssertions\"])\n                  ? (project[\"ecm:literalAssertions\"] as unknown[])\n                  : [];\n                onProjectChange({\n                  ...project,\n                  \"ecm:literalAssertions\": [...existing, newAssertion],\n                });\n              }\n              setAddLiteralOpen(false);\n            }}\n            onClose={() => { setAddLiteralOpen(false); }}\n          />\n        )}\n        {deleteInstanceConfirmOpen && (",
            "after": "        {addLiteralOpen && (\n          <AddLiteralDialog\n            project={project}\n            subjectIri={selectedInstanceId}\n            onConfirm={(newAssertion) => {\n              if (onProjectChange !== undefined && project !== null) {\n                const existing = Array.isArray(project[\"ecm:literalAssertions\"])\n                  ? (project[\"ecm:literalAssertions\"] as unknown[])\n                  : [];\n                onProjectChange({\n                  ...project,\n                  \"ecm:literalAssertions\": [...existing, newAssertion],\n                });\n              }\n              setAddLiteralOpen(false);\n            }}\n            onClose={() => { setAddLiteralOpen(false); }}\n          />\n        )}\n        {addAnnotationOpen && (\n          <AddAnnotationDialog\n            project={project}\n            subjectIri={selectedInstanceId}\n            onConfirm={(newAssertion) => {\n              if (onProjectChange !== undefined && project !== null) {\n                const existing = Array.isArray(project[\"ecm:literalAssertions\"])\n                  ? (project[\"ecm:literalAssertions\"] as unknown[])\n                  : [];\n                onProjectChange({\n                  ...project,\n                  \"ecm:literalAssertions\": [...existing, newAssertion],\n                });\n              }\n              setAddAnnotationOpen(false);\n            }}\n            onClose={() => { setAddAnnotationOpen(false); }}\n          />\n        )}\n        {deleteInstanceConfirmOpen && (",
            "scope": "minimal"
          }
        ],
        "tests_recommended": [
          {
            "file": "tests/inspector-annotation-add.spec.ts",
            "describe": "Add Annotation button: clicking 'Add Annotation' (gw-btn-add-annotation) opens dialog (gw-dialog-add-annotation); gw-select-annotation-predicate is pre-populated with annotation properties from STARTER_TERMS (rdfs:comment, rdfs:label, rdfs:seeAlso); submitting with a value appends an ecm:LiteralAssertion with the selected predicateIri and type='ecm:LiteralAssertion' to ecm:literalAssertions; the new assertion appears in the gw-annotation-literal-entry list; Cancel closes without mutation. Fixture: project with no user-defined owl:AnnotationProperty terms (to exercise the STARTER_TERMS fallback path) and at least one with a user-defined owl:AnnotationProperty term (to exercise the ecm:terms path)."
          },
          {
            "file": "tests/inspector-annotation-add.spec.ts",
