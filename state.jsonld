                "excerpt": "const PREFIX_MAP: Record<string, string> = {\n  ecm:  ...,\n  ...\n  iao:  \"http://purl.obolibrary.org/obo/iao#\",\n  cco:  ...\n};"
              }
            ],
            "kind": "inference"
          },
