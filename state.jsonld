      "inputs": {
        "phase": "phase-3",
        "chain_label": "Phase 3 Chain 5 sub-task B -- sidebar max-height + per-section search",
        "purpose": "Sub-task B per ft-821-test-p3-c4-1 (state B). Extend src/ui/TermSidebar.tsx: (1) add a per-section max-height with overflow-y: auto so large ontology imports (BFO, CCO) don't blow out the sidebar layout (current behavior: lists grow unbounded; Aaron 2026-06-04 hit this on BFO); (2) add a per-section search input above each section title that filters the visible terms by case-insensitive substring match on label OR IRI; (3) when search has 0 matches, show an explicit empty state ('No matches for ...'); (4) test-ids: gw-term-section-search-classes, gw-term-section-search-object-properties, gw-term-section-search-datatype-properties, gw-term-section-search-annotation-properties (one per section); (5) preserve the existing gw-term-section-* and aria-disabled behavior for imported terms (Chain 3.2-UI sub-task B contract). Style work goes in src/ui/App.css (or whatever CSS file recon identifies). Filter logic is local React useState; no kernel touches. Per CLAUDE.md section 9: src/ui/ is Layer 2; may import from src/kernel/ + composition + adapters.",
        "files_in_scope": [
          "src/ui/TermSidebar.tsx (modify: add search input + filter state per section + max-height container class)",
          "src/ui/App.css (modify: add .gw-term-section-list class with max-height + overflow-y)"
        ],
        "spec_refs": [
          "SPEC section 14.2",
          "SPEC section 26",
          "IMPLEMENTATION_PLAN section 3.4"
        ],
        "constraint": "Two-file change. Search filter is local React state; no kernel mutation. Preserve all existing test-ids and aria-disabled behavior from Chain 3.2-UI. Per CLAUDE.md section 9 layer boundaries.",
        "ft_anchor": "ft-821-test-p3-c4-1"
      },
      "attempts": 1,
      "outputs": {
        "changes": [
          {
            "id": "C1",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Extend TermSection to accept searchTestId, manage local searchQuery state, render a per-section search input above the section title, filter the visible term list by case-insensitive substring on resolved label OR IRI, show 'No matches for ...' when the filtered list is empty but the query is non-empty, and apply gw-term-section-list on the <ul> for the max-height constraint. All existing test-ids (data-testid={testId}, data-testid='gw-term-item') and aria-disabled behavior are preserved unchanged.",
            "before": "function TermSection({\n  title,\n  terms,\n  testId,\n  onAddTerm,\n  addTestId,\n  onTermClick,\n  onImportedTermClick,\n}: {\n  title: string;\n  terms: TermEntry[];\n  testId: string;\n  onAddTerm?: () => void;\n  addTestId?: string;\n  onTermClick?: (term: TermEntry) => void;\n  onImportedTermClick?: (term: TermEntry) => void;\n}) {\n  return (\n    <section className=\"gw-term-section\" data-testid={testId}>\n      <div className=\"gw-term-section-header\">\n        <h3 className=\"gw-term-section-title\">{title}</h3>\n        {onAddTerm !== undefined && (\n          <button\n            type=\"button\"\n            className=\"gw-btn-add-term\"\n            onClick={onAddTerm}\n            aria-label={`Add ${title}`}\n            data-testid={addTestId}\n          >\n            +\n          </button>\n        )}\n      </div>\n      {terms.length === 0 ? (\n        <p className=\"gw-term-empty\">No {title.toLowerCase()} yet</p>\n      ) : (\n        <ul className=\"gw-term-list\">\n          {terms.map((term) => {\n            const rawTermLabel = resolveTermLabel(term[\"rdfs:label\"]);\n            const displayLabel = rawTermLabel.length > 0 ? rawTermLabel : iriTail(term.id);\n            // Only project-created terms are clickable; imported/starter are not.\n            const isClickable =\n              onTermClick !== undefined &&\n              term[\"ecm:source\"] === \"ecm:project-created\";\n            // Imported-ontology terms carry an affirmative read-only signal (FR-U010; Chain C).\n            const isImported = term[\"ecm:source\"] === \"ecm:imported-ontology\";\n            // Imported terms may fire a separate read-only callback (FR-U010; sub-task B).\n            const hasImportedClickHandler =\n              isImported && onImportedTermClick !== undefined;\n            return (\n              <li\n                key={term.id}\n                className={\n                  isClickable\n                    ? \"gw-term-item gw-term-item--clickable\"\n                    : \"gw-term-item\"\n                }\n                data-testid=\"gw-term-item\"\n                role={isClickable ? \"button\" : undefined}\n                tabIndex={isClickable ? 0 : undefined}\n                aria-disabled={isImported ? \"true\" : undefined}\n                onClick={\n                  isClickable\n                    ? () => { onTermClick(term); }\n                    : hasImportedClickHandler\n                    ? () => { onImportedTermClick?.(term); }\n                    : undefined\n                }\n                onKeyDown={\n                  isClickable\n                    ? (e) => {\n                        if (e.key === \"Enter\" || e.key === \" \") {\n                          onTermClick(term);\n                        }\n                      }\n                    : undefined\n                }\n              >\n                <span className=\"gw-term-label\">{displayLabel}</span>\n                <SourceBadge source={term[\"ecm:source\"]} />\n              </li>\n            );\n          })}\n        </ul>\n      )}\n    </section>\n  );\n}",
            "after": "function TermSection({\n  title,\n  terms,\n  testId,\n  onAddTerm,\n  addTestId,\n  onTermClick,\n  onImportedTermClick,\n  searchTestId,\n}: {\n  title: string;\n  terms: TermEntry[];\n  testId: string;\n  onAddTerm?: () => void;\n  addTestId?: string;\n  onTermClick?: (term: TermEntry) => void;\n  onImportedTermClick?: (term: TermEntry) => void;\n  searchTestId: string;\n}) {\n  const [searchQuery, setSearchQuery] = useState(\"\");\n\n  const filteredTerms =\n    searchQuery.trim() === \"\"\n      ? terms\n      : terms.filter((term) => {\n          const q = searchQuery.toLowerCase();\n          const rawLabel = resolveTermLabel(term[\"rdfs:label\"]);\n          return (\n            rawLabel.toLowerCase().includes(q) ||\n            term.id.toLowerCase().includes(q)\n          );\n        });\n\n  return (\n    <section className=\"gw-term-section\" data-testid={testId}>\n      <input\n        type=\"search\"\n        className=\"gw-term-section-search\"\n        placeholder={`Search ${title.toLowerCase()}...`}\n        value={searchQuery}\n        onChange={(e) => setSearchQuery(e.target.value)}\n        aria-label={`Search ${title}`}\n        data-testid={searchTestId}\n      />\n      <div className=\"gw-term-section-header\">\n        <h3 className=\"gw-term-section-title\">{title}</h3>\n        {onAddTerm !== undefined && (\n          <button\n            type=\"button\"\n            className=\"gw-btn-add-term\"\n            onClick={onAddTerm}\n            aria-label={`Add ${title}`}\n            data-testid={addTestId}\n          >\n            +\n          </button>\n        )}\n      </div>\n      {filteredTerms.length === 0 && searchQuery.trim() !== \"\" ? (\n        <p className=\"gw-term-empty\">No matches for \"{searchQuery}\"</p>\n      ) : filteredTerms.length === 0 ? (\n        <p className=\"gw-term-empty\">No {title.toLowerCase()} yet</p>\n      ) : (\n        <ul className=\"gw-term-list gw-term-section-list\">\n          {filteredTerms.map((term) => {\n            const rawTermLabel = resolveTermLabel(term[\"rdfs:label\"]);\n            const displayLabel = rawTermLabel.length > 0 ? rawTermLabel : iriTail(term.id);\n            // Only project-created terms are clickable; imported/starter are not.\n            const isClickable =\n              onTermClick !== undefined &&\n              term[\"ecm:source\"] === \"ecm:project-created\";\n            // Imported-ontology terms carry an affirmative read-only signal (FR-U010; Chain C).\n            const isImported = term[\"ecm:source\"] === \"ecm:imported-ontology\";\n            // Imported terms may fire a separate read-only callback (FR-U010; sub-task B).\n            const hasImportedClickHandler =\n              isImported && onImportedTermClick !== undefined;\n            return (\n              <li\n                key={term.id}\n                className={\n                  isClickable\n                    ? \"gw-term-item gw-term-item--clickable\"\n                    : \"gw-term-item\"\n                }\n                data-testid=\"gw-term-item\"\n                role={isClickable ? \"button\" : undefined}\n                tabIndex={isClickable ? 0 : undefined}\n                aria-disabled={isImported ? \"true\" : undefined}\n                onClick={\n                  isClickable\n                    ? () => { onTermClick(term); }\n                    : hasImportedClickHandler\n                    ? () => { onImportedTermClick?.(term); }\n                    : undefined\n                }\n                onKeyDown={\n                  isClickable\n                    ? (e) => {\n                        if (e.key === \"Enter\" || e.key === \" \") {\n                          onTermClick(term);\n                        }\n                      }\n                    : undefined\n                }\n              >\n                <span className=\"gw-term-label\">{displayLabel}</span>\n                <SourceBadge source={term[\"ecm:source\"]} />\n              </li>\n            );\n          })}\n        </ul>\n      )}\n    </section>\n  );\n}",
            "scope": "moderate"
          },
          {
            "id": "C2",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Add searchTestId prop to all four TermSection call sites, supplying the four test-ids specified in the task: gw-term-section-search-classes, gw-term-section-search-object-properties, gw-term-section-search-datatype-properties, gw-term-section-search-annotation-properties. All existing props are unchanged.",
            "before": "      <TermSection\n        title=\"Classes\"\n        terms={classes}\n        testId=\"gw-term-section-classes\"\n        onAddTerm={canEdit ? () => setAddDialogType(\"owl:Class\") : undefined}\n        addTestId=\"gw-btn-add-class\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n      />\n      <TermSection\n        title=\"Object Properties\"\n        terms={objectProperties}\n        testId=\"gw-term-section-object-properties\"\n        onAddTerm={\n          canEdit ? () => setAddDialogType(\"owl:ObjectProperty\") : undefined\n        }\n        addTestId=\"gw-btn-add-object-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n      />\n      <TermSection\n        title=\"Datatype Properties\"\n        terms={datatypeProperties}\n        testId=\"gw-term-section-datatype-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setPropertyDialogType(\"owl:DatatypeProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-datatype-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n      />\n      <TermSection\n        title=\"Annotation Properties\"\n        terms={annotationProperties}\n        testId=\"gw-term-section-annotation-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setPropertyDialogType(\"owl:AnnotationProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-annotation-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n      />",
            "after": "      <TermSection\n        title=\"Classes\"\n        terms={classes}\n        testId=\"gw-term-section-classes\"\n        onAddTerm={canEdit ? () => setAddDialogType(\"owl:Class\") : undefined}\n        addTestId=\"gw-btn-add-class\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n        searchTestId=\"gw-term-section-search-classes\"\n      />\n      <TermSection\n        title=\"Object Properties\"\n        terms={objectProperties}\n        testId=\"gw-term-section-object-properties\"\n        onAddTerm={\n          canEdit ? () => setAddDialogType(\"owl:ObjectProperty\") : undefined\n        }\n        addTestId=\"gw-btn-add-object-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n        searchTestId=\"gw-term-section-search-object-properties\"\n      />\n      <TermSection\n        title=\"Datatype Properties\"\n        terms={datatypeProperties}\n        testId=\"gw-term-section-datatype-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setPropertyDialogType(\"owl:DatatypeProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-datatype-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n        searchTestId=\"gw-term-section-search-datatype-properties\"\n      />\n      <TermSection\n        title=\"Annotation Properties\"\n        terms={annotationProperties}\n        testId=\"gw-term-section-annotation-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setPropertyDialogType(\"owl:AnnotationProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-annotation-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n        onImportedTermClick={onImportedTermClick}\n        searchTestId=\"gw-term-section-search-annotation-properties\"\n      />",
