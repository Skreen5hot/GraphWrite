            "rationale": "\u00c2\u00a75.2 normative context: add @id alias binding to iao:isAbout entry so JSON-LD expansion yields the canonical IAO IRI http://purl.obolibrary.org/obo/IAO_0000136.",
            "before": "    \"iao:isAbout\":          { \"@type\": \"@id\", \"@container\": \"@set\" },",
            "after": "    \"iao:isAbout\":          { \"@id\": \"obo:IAO_0000136\", \"@type\": \"@id\", \"@container\": \"@set\" },",
