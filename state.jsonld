      "@id": "urn:fnsr:task:275-recon-turtle-prefix",
      "agent": "reconnaissance",
      "status": "done",
      "attempts": 1,
      "outputs": {
        "findings": [
          {
            "id": "F1",
            "claim": "IRI-to-string serialization in turtle.ts routes through two closely-coupled helpers: `expandIri` (compact\u00e2\u2020\u2019full IRI, lines 47\u00e2\u20ac\u201c52) and `termForIri` (lines 55\u00e2\u20ac\u201c57), with `makeLiteralTerm` (lines 83\u00e2\u20ac\u201c88) using `expandIri` for datatype IRIs; these are the only IRI-expansion sites.",
            "evidence": [
              {
                "file": "src/emit/turtle.ts",
                "lines": "47-52",
                "excerpt": "function expandIri(compact: string): string {\n  const colon = compact.indexOf(\":\");\n  if (colon <= 0) return compact;\n  const ns = PREFIX_MAP[compact.slice(0, colon)];\n  return ns !== undefined ? ns + compact.slice(colon + 1) : compact;\n}"
              },
              {
                "file": "src/emit/turtle.ts",
                "lines": "55-57",
                "excerpt": "function termForIri(iri: string) {\n  return iri.startsWith(\"_:\") ? blankNode(iri.slice(2)) : namedNode(expandIri(iri));\n}"
              },
              {
                "file": "src/emit/turtle.ts",
                "lines": "83-88",
                "excerpt": "function makeLiteralTerm(value: string, datatype: string, lang: string | null) {\n  if (lang !== null && ...) { return literal(value, lang); }\n  return literal(value, namedNode(expandIri(datatype)));\n}"
              }
            ],
            "kind": "observation"
          },
          {
            "id": "F2",
            "claim": "turtle.ts maintains an internal `PREFIX_MAP` (lines 33\u00e2\u20ac\u201c41) used exclusively for compact\u00e2\u2020\u2019full IRI expansion; the N3 Writer is instantiated at line 258 with no `prefixes` option, so the body is currently emitted as full-IRI Turtle (all terms as `<https://\u00e2\u20ac\u00a6>` notation).",
            "evidence": [
              {
                "file": "src/emit/turtle.ts",
                "lines": "33-41",
                "excerpt": "const PREFIX_MAP: Record<string, string> = {\n  ecm:  \"https://edgecanonical.org/ns/modeler#\",\n  rdf:  \"http://www.w3.org/1999/02/22-rdf-syntax-ns#\",\n  rdfs: \"http://www.w3.org/2000/01/rdf-schema#\",\n  owl:  \"http://www.w3.org/2002/07/owl#\",\n  xsd:  \"http://www.w3.org/2001/XMLSchema#\",\n  iao:  \"http://purl.obolibrary.org/obo/iao#\",\n  cco:  \"https://www.commoncoreontologies.org/\",\n};"
              },
              {
                "file": "src/emit/turtle.ts",
