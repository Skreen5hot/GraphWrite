          },
          {
            "id": "C9",
            "file": "tests/playwright/relation-crud.spec.ts",
            "rationale": "Update AC3 display assertions from toHaveText(rawUUID) to toContainText(iriTail). The fixture instances have no rdfs:label, so the fallback is iriTail(iri) using CanvasView's regex: iriTail('urn:uuid:c3000000-0000-0000-0000-000000000001') = '000000000001', iriTail('...000000000002') = '000000000002'. toContainText is correct because the element now contains both the primary displayLabel span and the secondary full-IRI span; exact toHaveText would need to match the concatenated text. The post-Reverse and post-Save data-model checks (which use originalSubject/originalObject for ecm:subjectIri / ecm:objectIri assertions) are unchanged -- they test the data model, not display text.",
            "before": "      await expect(page.getByTestId(\"gw-inspector-subject\")).toHaveText(\n        originalSubject,\n      );\n      await expect(page.getByTestId(\"gw-inspector-object\")).toHaveText(\n        originalObject,\n      );\n\n      // Click Reverse.\n      await page.getByTestId(\"gw-btn-reverse\").click();\n\n      // Inspector must immediately reflect the swap.\n      await expect(page.getByTestId(\"gw-inspector-subject\")).toHaveText(\n        originalObject,\n      );\n      await expect(page.getByTestId(\"gw-inspector-object\")).toHaveText(\n        originalSubject,\n      );",
            "after": "      // Quick-3: Subject/Object rows now show displayLabel (iriTail when no rdfs:label).\n      // Fixture has no rdfs:label on instances; iriTail falls back to the last UUID segment.\n      // iriTail(\"urn:uuid:c3000000-0000-0000-0000-000000000001\") => \"000000000001\"\n      // iriTail(\"urn:uuid:c3000000-0000-0000-0000-000000000002\") => \"000000000002\"\n      await expect(page.getByTestId(\"gw-inspector-subject\")).toContainText(\n        \"000000000001\",\n      );\n      await expect(page.getByTestId(\"gw-inspector-object\")).toContainText(\n        \"000000000002\",\n      );\n\n      // Click Reverse.\n      await page.getByTestId(\"gw-btn-reverse\").click();\n\n      // Inspector must immediately reflect the swap.\n      await expect(page.getByTestId(\"gw-inspector-subject\")).toContainText(\n        \"000000000002\",\n      );\n      await expect(page.getByTestId(\"gw-inspector-object\")).toContainText(\n        \"000000000001\",\n      );",
            "scope": "minimal"
          }
        ],
