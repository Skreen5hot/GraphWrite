                "excerpt": "const TBOX_IDS = new Set([\n  \"ecm:OntologyDesignPattern\",\n  \"ecm:Project\",\n  \"ecm:Serialization\",\n  \"ecm:isSerializationOf\",\n  \"ecm:UnspecifiedSubjectMatter\",\n]);"
