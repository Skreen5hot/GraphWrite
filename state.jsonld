    {
      "@id": "urn:fnsr:task:364-dev-r4-3a",
      "agent": "developer",
      "status": "done",
      "attempts": 1,
      "outputs": {
        "changes": [
          {
            "id": "C1a",
            "file": "src/normalize/index.ts",
            "rationale": "Add exported LabelShape type to the Types section for use by ADR-008 shape consumers.",
            "before": "// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/** Result of normalizeOnLoad. */\nexport interface NormalizeOnLoadResult {",
            "after": "// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/** Canonical {text, lang} shape for rdfs:label on ecm:terms entries (ADR-008). */\nexport interface LabelShape {\n  text: string;\n  lang: string;\n}\n\n/** Result of normalizeOnLoad. */\nexport interface NormalizeOnLoadResult {",
            "scope": "minimal"
          },
          {
            "id": "C1b",
            "file": "src/normalize/index.ts",
            "rationale": "Add exported normalizeLabelShape helper (idempotent: string->\"{text,lang}\"; object passthrough). Update normalizeOnLoad to apply label-shape coercion to ecm:terms entries before the serializeVmp structural comparison, enabling backward-compat load of legacy plain-string-label documents.",
            "before": "// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Normalize a VMP project document to canonical form on load.\n *\n * Structural canonicality is detected by comparing the output of\n * serializeVmp(doc) against JSON.stringify(doc, null, 2) + \"\\n\". If they\n * differ, the document contains non-canonical structure (wrong key order,\n * unsorted arrays, non-normalized timestamps, missing @context, etc.) and\n * is normalized by passing through serializeVmp + JSON.parse.\n *\n * Idempotent: a second call on the result of a first call always returns\n * wasNormalized: false.\n *\n * When wasNormalized is true, the returned document carries the\n * ecm:_wasNormalizedOnLoad marker so that validate() can emit the\n * NORMALIZED_ON_SAVE info finding (SPEC section 17.4).\n *\n * @param doc - Parsed VMP project document (Record<string, unknown>).\n *   May use @id/@type or compact id/type keys.\n * @returns NormalizeOnLoadResult. If wasNormalized is false, document is the\n *   same object reference as the input. If wasNormalized is true, document is\n *   a freshly parsed canonical copy with ecm:_wasNormalizedOnLoad set.\n */\nexport function normalizeOnLoad(\n  doc: Record<string, unknown>,\n): NormalizeOnLoadResult {\n  // Strip the marker before comparison so that a second call on a document\n  // that was already normalized (and carries the marker) still returns\n  // wasNormalized: false.\n  const docForComparison: Record<string, unknown> = { ...doc };\n  delete docForComparison[NORMALIZED_ON_LOAD_MARKER];\n\n  const canonical = serializeVmp(docForComparison);\n  const inputAsSerialized = JSON.stringify(docForComparison, null, 2) + \"\\n\";\n\n  if (canonical === inputAsSerialized) {\n    // Already canonical. Return the original document (preserving any\n    // existing marker from a previous call).\n    return { document: doc, wasNormalized: false };\n  }\n\n  // Document was not in canonical form. Normalize and set the marker so\n  // that validate() can emit NORMALIZED_ON_SAVE.\n  const normalized = JSON.parse(canonical) as Record<string, unknown>;\n  normalized[NORMALIZED_ON_LOAD_MARKER] = true;\n  return { document: normalized, wasNormalized: true };\n}",
            "after": "// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Normalize a raw rdfs:label value to the canonical {text, lang} shape\n * required by ADR-008 for ecm:terms entries.\n *\n * Idempotent: plain string -> {text, lang: 'en'}; {text, lang} object -> same\n * reference (cast). Any other shape returns {text: '', lang: 'en'}.\n */\nexport function normalizeLabelShape(raw: unknown): LabelShape {\n  if (typeof raw === \"string\") {\n    return { text: raw, lang: \"en\" };\n  }\n  if (\n    typeof raw === \"object\" &&\n    raw !== null &&\n    typeof (raw as Record<string, unknown>)[\"text\"] === \"string\" &&\n    typeof (raw as Record<string, unknown>)[\"lang\"] === \"string\"\n  ) {\n    return raw as LabelShape;\n  }\n  return { text: \"\", lang: \"en\" };\n}\n\n/**\n * Normalize a VMP project document to canonical form on load.\n *\n * Step 1: Apply label-shape normalization to ecm:terms entries\n * (plain-string rdfs:label -> {text, lang: 'en'} per ADR-008).\n *\n * Step 2: Structural canonicality is detected by comparing the output of\n * serializeVmp(doc) against JSON.stringify(doc, null, 2) + \"\\n\". If they\n * differ, the document contains non-canonical structure (wrong key order,\n * unsorted arrays, non-normalized timestamps, missing @context, etc.) and\n * is normalized by passing through serializeVmp + JSON.parse.\n *\n * Idempotent: a second call on the result of a first call always returns\n * wasNormalized: false.\n *\n * When wasNormalized is true, the returned document carries the\n * ecm:_wasNormalizedOnLoad marker so that validate() can emit the\n * NORMALIZED_ON_SAVE info finding (SPEC section 17.4).\n *\n * @param doc - Parsed VMP project document (Record<string, unknown>).\n *   May use @id/@type or compact id/type keys.\n * @returns NormalizeOnLoadResult. If wasNormalized is false, document is the\n *   same object reference as the input. If wasNormalized is true, document is\n *   a freshly parsed canonical copy with ecm:_wasNormalizedOnLoad set.\n */\nexport function normalizeOnLoad(\n  doc: Record<string, unknown>,\n): NormalizeOnLoadResult {\n  // Strip the marker before comparison so that a second call on a document\n  // that was already normalized (and carries the marker) still returns\n  // wasNormalized: false.\n  const docWithoutMarker: Record<string, unknown> = { ...doc };\n  delete docWithoutMarker[NORMALIZED_ON_LOAD_MARKER];\n\n  // Step 1: Apply label-shape normalization to ecm:terms.\n  // Plain-string rdfs:label values are coerced to {text, lang: 'en'}.\n  let labelNormalized = false;\n  let docForComparison: Record<string, unknown> = docWithoutMarker;\n  const rawTerms = docWithoutMarker[\"ecm:terms\"];\n  if (Array.isArray(rawTerms)) {\n    const normalizedTerms = (rawTerms as unknown[]).map((term) => {\n      if (typeof term !== \"object\" || term === null) return term;\n      const t = term as Record<string, unknown>;\n      if (typeof t[\"rdfs:label\"] === \"string\") {\n        labelNormalized = true;\n        return { ...t, \"rdfs:label\": normalizeLabelShape(t[\"rdfs:label\"]) };\n      }\n      return t;\n    });\n    if (labelNormalized) {\n      docForComparison = { ...docWithoutMarker, \"ecm:terms\": normalizedTerms };\n    }\n  }\n\n  // Step 2: Structural canonicalization via serializeVmp round-trip.\n  const canonical = serializeVmp(docForComparison);\n  const inputAsSerialized = JSON.stringify(docForComparison, null, 2) + \"\\n\";\n\n  if (canonical === inputAsSerialized && !labelNormalized) {\n    // Already canonical and no label coercion performed.\n    return { document: doc, wasNormalized: false };\n  }\n\n  // Document was not in canonical form (or labels were coerced).\n  // Normalize and set the marker so that validate() can emit NORMALIZED_ON_SAVE.\n  const normalized = JSON.parse(canonical) as Record<string, unknown>;\n  normalized[NORMALIZED_ON_LOAD_MARKER] = true;\n  return { document: normalized, wasNormalized: true };\n}",
            "scope": "moderate"
          },
          {
            "id": "C2",
            "file": "src/migrate/index.ts",
            "rationale": "Add label-shape coercion step in migrateV3toV4: plain-string rdfs:label on ecm:terms entries is converted to {text, lang: 'en'} per ADR-008. Records the transformation in the migration report.",
            "before": "  // ft-097-test-validator-3 Option A: marker tells validate() to emit\n  // LEGACY_REALIST_ANCHOR_PLACEHOLDER info finding instead of MISSING_REALIST_ANCHOR\n  // error. Not listed in migration report (implementation detail).\n  result[\"ecm:_legacyAnchorPlaceholder\"] = true;\n\n  return { doc: result, added, transformed };\n}",
            "after": "  // ADR-008: Coerce plain-string rdfs:label values on ecm:terms to\n  // the canonical {text, lang: 'en'} shape. Idempotent: already-shaped\n  // values pass through unchanged.\n  const termsForLabel = result[\"ecm:terms\"];\n  if (Array.isArray(termsForLabel)) {\n    let labelCoerced = false;\n    result[\"ecm:terms\"] = (termsForLabel as unknown[]).map((term) => {\n      if (typeof term !== \"object\" || term === null) return term;\n      const t = { ...(term as Record<string, unknown>) };\n      if (typeof t[\"rdfs:label\"] === \"string\") {\n        t[\"rdfs:label\"] = { text: t[\"rdfs:label\"] as string, lang: \"en\" };\n        labelCoerced = true;\n      }\n      return t;\n    });\n    if (labelCoerced) {\n      transformed.push(\"ecm:terms[*].rdfs:label\");\n    }\n  }\n\n  // ft-097-test-validator-3 Option A: marker tells validate() to emit\n  // LEGACY_REALIST_ANCHOR_PLACEHOLDER info finding instead of MISSING_REALIST_ANCHOR\n  // error. Not listed in migration report (implementation detail).\n  result[\"ecm:_legacyAnchorPlaceholder\"] = true;\n\n  return { doc: result, added, transformed };\n}",
            "scope": "minimal"
          },
          {
            "id": "C3",
            "file": "src/validate/index.ts",
            "rationale": "Update CANONICAL_RESERVED_NAME_COLLISION label extraction to read .text from {text, lang} objects (ADR-008 shape) in addition to plain strings.",
            "before": "      const termLabel =\n        typeof t[\"rdfs:label\"] === \"string\" ? t[\"rdfs:label\"] : termId;",
            "after": "      const rawLabel = t[\"rdfs:label\"];\n      const termLabel =\n        typeof rawLabel === \"string\"\n          ? rawLabel\n          : typeof rawLabel === \"object\" &&\n            rawLabel !== null &&\n            typeof (rawLabel as Record<string, unknown>)[\"text\"] === \"string\"\n          ? ((rawLabel as Record<string, unknown>)[\"text\"] as string)\n          : termId;",
            "scope": "minimal"
          },
          {
            "id": "C4a",
            "file": "src/validate/starter-terms.ts",
            "rationale": "Update EcmTerm interface: rdfs:label type changes from plain string to {text, lang} object per ADR-008.",
            "before": "  \"ecm:createdAt\": string;\n  \"ecm:updatedAt\": string;\n  \"rdfs:label\": string;\n}",
            "after": "  \"ecm:createdAt\": string;\n  \"ecm:updatedAt\": string;\n  \"rdfs:label\": { text: string; lang: string };\n}",
            "scope": "minimal"
          },
          {
            "id": "C4b",
            "file": "src/validate/starter-terms.ts",
            "rationale": "Update STARTER_TERMS data: rdfs:label values on all three entries converted from plain strings to {text, lang: 'en'} per ADR-008.",
            "before": "export const STARTER_TERMS: ReadonlyArray<EcmTerm> = [\n  // ---- rdfs: annotation properties (http://www.w3.org/2000/01/rdf-schema#) --\n  // Fragment order: comment < label < seeAlso (lexicographic)\n  {\n    id: \"http://www.w3.org/2000/01/rdf-schema#comment\",\n    type: \"owl:AnnotationProperty\",\n    \"ecm:source\": \"ecm:system-starter-example\",\n    \"ecm:ontologyId\": null,\n    \"ecm:createdAt\": EPOCH,\n    \"ecm:updatedAt\": EPOCH,\n    \"rdfs:label\": \"comment\",\n  },\n  {\n    id: \"http://www.w3.org/2000/01/rdf-schema#label\",\n    type: \"owl:AnnotationProperty\",\n    \"ecm:source\": \"ecm:system-starter-example\",\n    \"ecm:ontologyId\": null,\n    \"ecm:createdAt\": EPOCH,\n    \"ecm:updatedAt\": EPOCH,\n    \"rdfs:label\": \"label\",\n  },\n  {\n    id: \"http://www.w3.org/2000/01/rdf-schema#seeAlso\",\n    type: \"owl:AnnotationProperty\",\n    \"ecm:source\": \"ecm:system-starter-example\",\n    \"ecm:ontologyId\": null,\n    \"ecm:createdAt\": EPOCH,\n    \"ecm:updatedAt\": EPOCH,\n    \"rdfs:label\": \"seeAlso\",\n  },\n];",
            "after": "export const STARTER_TERMS: ReadonlyArray<EcmTerm> = [\n  // ---- rdfs: annotation properties (http://www.w3.org/2000/01/rdf-schema#) --\n  // Fragment order: comment < label < seeAlso (lexicographic)\n  {\n    id: \"http://www.w3.org/2000/01/rdf-schema#comment\",\n    type: \"owl:AnnotationProperty\",\n    \"ecm:source\": \"ecm:system-starter-example\",\n    \"ecm:ontologyId\": null,\n    \"ecm:createdAt\": EPOCH,\n    \"ecm:updatedAt\": EPOCH,\n    \"rdfs:label\": { text: \"comment\", lang: \"en\" },\n  },\n  {\n    id: \"http://www.w3.org/2000/01/rdf-schema#label\",\n    type: \"owl:AnnotationProperty\",\n    \"ecm:source\": \"ecm:system-starter-example\",\n    \"ecm:ontologyId\": null,\n    \"ecm:createdAt\": EPOCH,\n    \"ecm:updatedAt\": EPOCH,\n    \"rdfs:label\": { text: \"label\", lang: \"en\" },\n  },\n  {\n    id: \"http://www.w3.org/2000/01/rdf-schema#seeAlso\",\n    type: \"owl:AnnotationProperty\",\n    \"ecm:source\": \"ecm:system-starter-example\",\n    \"ecm:ontologyId\": null,\n    \"ecm:createdAt\": EPOCH,\n    \"ecm:updatedAt\": EPOCH,\n    \"rdfs:label\": { text: \"seeAlso\", lang: \"en\" },\n  },\n];",
            "scope": "minimal"
          },
          {
            "id": "C5",
            "file": "src/ui/label-resolution.ts",
            "rationale": "Add resolveTermLabel helper export: extracts display text from either a plain-string or {text, lang} rdfs:label value. Used by all UI components reading term labels.",
            "before": "/**\n * Build a map from instance IRI to display label by scanning the project's\n * ecm:instances array. Falls back to the IRI itself when rdfs:label is absent.\n */\nexport function buildInstanceLabelMap(",
            "after": "/**\n * Resolve the display text from a term's rdfs:label value.\n * Handles both plain-string (legacy) and {text, lang} (ADR-008) shapes.\n * Returns empty string for absent or malformed values.\n */\nexport function resolveTermLabel(raw: unknown): string {\n  if (typeof raw === \"string\") return raw;\n  if (\n    typeof raw === \"object\" &&\n    raw !== null &&\n    typeof (raw as Record<string, unknown>)[\"text\"] === \"string\"\n  ) {\n    return (raw as Record<string, unknown>)[\"text\"] as string;\n  }\n  return \"\";\n}\n\n/**\n * Build a map from instance IRI to display label by scanning the project's\n * ecm:instances array. Falls back to the IRI itself when rdfs:label is absent.\n */\nexport function buildInstanceLabelMap(",
            "scope": "minimal"
          },
          {
            "id": "C6a",
            "file": "src/ui/CanvasView.tsx",
            "rationale": "Import resolveTermLabel from label-resolution for use in deriveEdges term label extraction.",
            "before": "import { iriTail } from \"./label-resolution.js\";",
            "after": "import { iriTail, resolveTermLabel } from \"./label-resolution.js\";",
            "scope": "minimal"
          },
          {
            "id": "C6b",
            "file": "src/ui/CanvasView.tsx",
            "rationale": "Update deriveEdges term label extraction to use resolveTermLabel, handling both plain-string and {text, lang} shapes. Instance label reading (plain string, ADR-008 terms-only scope) is unchanged.",
            "before": "      if (typeof term[\"rdfs:label\"] === \"string\" && (term[\"rdfs:label\"] as string).length > 0) {\n        termLabelMap.set(id, term[\"rdfs:label\"] as string);\n      }",
            "after": "      const termLabelText = resolveTermLabel(term[\"rdfs:label\"]);\n      if (termLabelText.length > 0) {\n        termLabelMap.set(id, termLabelText);\n      }",
            "scope": "minimal"
          },
          {
            "id": "C7a",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Import resolveTermLabel for use in term label extraction across all three term-reading functions in Inspector.",
            "before": "import { buildInstanceLabelMap, iriTail, resolveInstanceDisplay } from \"./label-resolution.js\";",
            "after": "import { buildInstanceLabelMap, iriTail, resolveInstanceDisplay, resolveTermLabel } from \"./label-resolution.js\";",
            "scope": "minimal"
          },
          {
            "id": "C7b",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Update resolveRelationNarration term label extraction to use resolveTermLabel instead of typeof === string guard.",
            "before": "      termLabel.set(id, typeof term[\"rdfs:label\"] === \"string\" ? term[\"rdfs:label\"] : id);",
            "after": "      const tl = resolveTermLabel(term[\"rdfs:label\"]);\n      termLabel.set(id, tl.length > 0 ? tl : id);",
            "scope": "minimal"
          },
          {
            "id": "C7c",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Update getObjectPropertyOptions label extraction to use resolveTermLabel.",
            "before": "    if (obj[\"type\"] !== \"owl:ObjectProperty\") continue;\n    const iri = obj[\"id\"] as string;\n    const label =\n      typeof obj[\"rdfs:label\"] === \"string\" && obj[\"rdfs:label\"].length > 0\n        ? (obj[\"rdfs:label\"] as string)\n        : iriTail(iri);\n    result.push({ iri, label });\n  }\n  return result;\n}\n\n/** Shape of an owl:DatatypeProperty option for the literal predicate display. */",
            "after": "    if (obj[\"type\"] !== \"owl:ObjectProperty\") continue;\n    const iri = obj[\"id\"] as string;\n    const labelText = resolveTermLabel(obj[\"rdfs:label\"]);\n    const label = labelText.length > 0 ? labelText : iriTail(iri);\n    result.push({ iri, label });\n  }\n  return result;\n}\n\n/** Shape of an owl:DatatypeProperty option for the literal predicate display. */",
            "scope": "minimal"
          },
          {
            "id": "C7d",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Update getDatatypePropertyOptions (Inspector-internal) label extraction to use resolveTermLabel.",
            "before": "    if (obj[\"type\"] !== \"owl:DatatypeProperty\") continue;\n    const iri = obj[\"id\"] as string;\n    const label =\n      typeof obj[\"rdfs:label\"] === \"string\" && (obj[\"rdfs:label\"] as string).length > 0\n        ? (obj[\"rdfs:label\"] as string)\n        : iriTail(iri);\n    result.push({ iri, label });\n  }\n  return result;\n}\n\n/** Shape of an owl:Class option for the class-assignment <select>. */",
            "after": "    if (obj[\"type\"] !== \"owl:DatatypeProperty\") continue;\n    const iri = obj[\"id\"] as string;\n    const labelText = resolveTermLabel(obj[\"rdfs:label\"]);\n    const label = labelText.length > 0 ? labelText : iriTail(iri);\n    result.push({ iri, label });\n  }\n  return result;\n}\n\n/** Shape of an owl:Class option for the class-assignment <select>. */",
            "scope": "minimal"
          },
          {
            "id": "C7e",
            "file": "src/ui/Inspector.tsx",
            "rationale": "Update getOwlClassOptions label extraction to use resolveTermLabel.",
            "before": "    if (obj[\"type\"] !== \"owl:Class\") continue;\n    const iri = obj[\"id\"] as string;\n    const label =\n      typeof obj[\"rdfs:label\"] === \"string\" && (obj[\"rdfs:label\"] as string).length > 0\n        ? (obj[\"rdfs:label\"] as string)\n        : iriTail(iri);\n    result.push({ iri, label });\n  }\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Inspector component (SPEC section 26; FR-U015/FR-U016/FR-U017/FR-U018)",
            "after": "    if (obj[\"type\"] !== \"owl:Class\") continue;\n    const iri = obj[\"id\"] as string;\n    const labelText = resolveTermLabel(obj[\"rdfs:label\"]);\n    const label = labelText.length > 0 ? labelText : iriTail(iri);\n    result.push({ iri, label });\n  }\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Inspector component (SPEC section 26; FR-U015/FR-U016/FR-U017/FR-U018)",
            "scope": "minimal"
          },
          {
            "id": "C8a",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Import resolveTermLabel from label-resolution for use in TermSection display label extraction.",
            "before": "import { useState } from \"react\";\nimport { AddTermDialog, type AddTermType } from \"./AddTermDialog.js\";\nimport { EditTermDialog } from \"./EditTermDialog.js\";",
            "after": "import { useState } from \"react\";\nimport { AddTermDialog, type AddTermType } from \"./AddTermDialog.js\";\nimport { EditTermDialog } from \"./EditTermDialog.js\";\nimport { resolveTermLabel } from \"./label-resolution.js\";",
            "scope": "minimal"
          },
          {
            "id": "C8b",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Widen TermEntry.rdfs:label type to accept both {text, lang} object (ADR-008) and legacy plain string. TypeScript will correctly narrow via resolveTermLabel at usage sites.",
            "before": "/** Shape of a single ecm:terms entry (SPEC \u00c2\u00a75.7). */\ninterface TermEntry {\n  id: string;\n  type: string;\n  \"rdfs:label\"?: string;\n  \"rdfs:comment\"?: string;\n  \"ecm:source\"?: string;\n}",
            "after": "/** Shape of a single ecm:terms entry (SPEC \u00c2\u00a75.7). */\ninterface TermEntry {\n  id: string;\n  type: string;\n  \"rdfs:label\"?: { text: string; lang: string } | string;\n  \"rdfs:comment\"?: string;\n  \"ecm:source\"?: string;\n}",
            "scope": "minimal"
          },
          {
            "id": "C8c",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Update TermSection display label extraction to use resolveTermLabel instead of typeof === string guard.",
            "before": "            const displayLabel =\n              typeof term[\"rdfs:label\"] === \"string\" &&\n              term[\"rdfs:label\"].length > 0\n                ? term[\"rdfs:label\"]\n                : iriTail(term.id);",
            "after": "            const rawTermLabel = resolveTermLabel(term[\"rdfs:label\"]);\n            const displayLabel = rawTermLabel.length > 0 ? rawTermLabel : iriTail(term.id);",
            "scope": "minimal"
          },
          {
            "id": "C9",
            "file": "src/ui/AddTermDialog.tsx",
            "rationale": "Write rdfs:label as {text, lang: 'en'} object when creating new project-created terms, per ADR-008.",
            "before": "    const now = new Date().toISOString();\n    const newTerm: Record<string, unknown> = {\n      \"ecm:createdAt\": now,\n      \"ecm:ontologyId\": null,\n      \"ecm:source\": \"ecm:project-created\",\n      \"ecm:updatedAt\": now,\n      id: iri,\n      \"rdfs:label\": trimmedLabel,\n      type: termType,\n    };\n    onConfirm(newTerm);",
            "after": "    const now = new Date().toISOString();\n    const newTerm: Record<string, unknown> = {\n      \"ecm:createdAt\": now,\n      \"ecm:ontologyId\": null,\n      \"ecm:source\": \"ecm:project-created\",\n      \"ecm:updatedAt\": now,\n      id: iri,\n      \"rdfs:label\": { text: trimmedLabel, lang: \"en\" },\n      type: termType,\n    };\n    onConfirm(newTerm);",
            "scope": "minimal"
          },
          {
            "id": "C10a",
            "file": "src/ui/EditTermDialog.tsx",
            "rationale": "Initialize label state by extracting .text from the {text, lang} object shape instead of calling readStr (which only handles plain strings). Falls back through legacy string shape for backward compat.",
            "before": "  const originalIri = readStr(term, \"id\");\n  const [label, setLabel] = useState(readStr(term, \"rdfs:label\"));",
            "after": "  const originalIri = readStr(term, \"id\");\n  const rawLabel = term[\"rdfs:label\"];\n  const [label, setLabel] = useState(\n    typeof rawLabel === \"string\"\n      ? rawLabel\n      : typeof rawLabel === \"object\" &&\n        rawLabel !== null &&\n        typeof (rawLabel as Record<string, unknown>)[\"text\"] === \"string\"\n      ? ((rawLabel as Record<string, unknown>)[\"text\"] as string)\n      : \"\",\n  );",
            "scope": "minimal"
          },
          {
            "id": "C10b",
            "file": "src/ui/EditTermDialog.tsx",
            "rationale": "Write rdfs:label as {text, lang: 'en'} object in applyTermEdit when saving edited terms, per ADR-008. The lang tag defaults to 'en'; existing lang values from non-English terms are not yet preserved (see open_questions).",
            "before": "    const updated: Record<string, unknown> = {\n      ...obj,\n      id: newIri,\n      \"rdfs:label\": newLabel,\n      \"ecm:updatedAt\": now,\n    };",
            "after": "    const updated: Record<string, unknown> = {\n      ...obj,\n      id: newIri,\n      \"rdfs:label\": { text: newLabel, lang: \"en\" },\n      \"ecm:updatedAt\": now,\n    };",
            "scope": "minimal"
          },
          {
            "id": "C11a",
            "file": "src/ui/AddLiteralDialog.tsx",
            "rationale": "Import resolveTermLabel for use in getDatatypePropertyOptions label extraction.",
            "before": "import { useState, type FormEvent } from \"react\";\nimport { Dialog } from \"./Dialog.js\";",
            "after": "import { useState, type FormEvent } from \"react\";\nimport { Dialog } from \"./Dialog.js\";\nimport { resolveTermLabel } from \"./label-resolution.js\";",
            "scope": "minimal"
          },
          {
            "id": "C11b",
            "file": "src/ui/AddLiteralDialog.tsx",
            "rationale": "Update getDatatypePropertyOptions label extraction to use resolveTermLabel, handling {text, lang} shape for predicate dropdown display.",
            "before": "    const label =\n      typeof obj[\"rdfs:label\"] === \"string\" && (obj[\"rdfs:label\"] as string).length > 0\n        ? (obj[\"rdfs:label\"] as string)\n        : iri;\n    result.push({ iri, label });",
            "after": "    const labelText = resolveTermLabel(obj[\"rdfs:label\"]);\n    const label = labelText.length > 0 ? labelText : iri;\n    result.push({ iri, label });",
            "scope": "minimal"
          },
          {
            "id": "C12",
            "file": "src/emit/turtle.ts",
            "rationale": "Split rdfs:label out of the string-literal predicates loop. Now handles two shapes: plain string (ecm:Instance labels, stays untagged) and {text, lang} object (ecm:terms labels, emits language-tagged rdf:langString via literal(text, lang)). Other predicates in the loop are unchanged.",
            "before": "  // String-literal predicates\n  for (const pred of [\n    \"rdfs:label\", \"rdfs:comment\", \"ecm:format\", \"ecm:filename\",\n    \"ecm:contentHash\", \"ecm:generatedAt\",\n  ]) {\n    const val = node[pred];\n    if (typeof val === \"string\") {\n      result.push(makeQuad(subj, namedNode(expandIri(pred)), literal(val)));\n    }\n  }",
            "after": "  // String-literal predicates (rdfs:label handled separately below)\n  for (const pred of [\n    \"rdfs:comment\", \"ecm:format\", \"ecm:filename\",\n    \"ecm:contentHash\", \"ecm:generatedAt\",\n  ]) {\n    const val = node[pred];\n    if (typeof val === \"string\") {\n      result.push(makeQuad(subj, namedNode(expandIri(pred)), literal(val)));\n    }\n  }\n\n  // rdfs:label: plain string (ecm:Instance, legacy) -> untagged literal;\n  // {text, lang} object (ecm:terms, ADR-008) -> language-tagged rdf:langString.\n  const labelVal = node[\"rdfs:label\"];\n  if (typeof labelVal === \"string\") {\n    result.push(makeQuad(subj, namedNode(expandIri(\"rdfs:label\")), literal(labelVal)));\n  } else if (\n    typeof labelVal === \"object\" &&\n    labelVal !== null &&\n    typeof (labelVal as Record<string, unknown>)[\"text\"] === \"string\" &&\n    typeof (labelVal as Record<string, unknown>)[\"lang\"] === \"string\"\n  ) {\n    const lv = labelVal as Record<string, unknown>;\n    result.push(makeQuad(\n      subj,\n      namedNode(expandIri(\"rdfs:label\")),\n      literal(lv[\"text\"] as string, lv[\"lang\"] as string),\n    ));\n  }",
            "scope": "minimal"
          },
          {
            "id": "C13a",
            "file": "src/emit/triple-narration.ts",
            "rationale": "Add module-private resolveLabel helper to extract display text from either plain-string or {text, lang} rdfs:label shapes. Kept local to avoid cross-layer import from src/ui/.",
            "before": "export function narrateProject(project: Record<string, unknown>): string[] {\n  const instanceLabel = new Map<string, string>();\n  const instanceClass = new Map<string, string>(); // instanceId -> first classIri\n  const termLabel     = new Map<string, string>();",
            "after": "/** Resolve display text from a raw rdfs:label value (string or {text,lang} object). */\nfunction resolveLabel(raw: unknown): string {\n  if (typeof raw === \"string\") return raw;\n  if (typeof raw === \"object\" && raw !== null) {\n    const text = (raw as Record<string, unknown>)[\"text\"];\n    if (typeof text === \"string\") return text;\n  }\n  return \"\";\n}\n\nexport function narrateProject(project: Record<string, unknown>): string[] {\n  const instanceLabel = new Map<string, string>();\n  const instanceClass = new Map<string, string>(); // instanceId -> first classIri\n  const termLabel     = new Map<string, string>();",
            "scope": "minimal"
          },
          {
            "id": "C13b",
            "file": "src/emit/triple-narration.ts",
            "rationale": "Update term label extraction in narrateProject to use resolveLabel. Instance label extraction (plain string per ADR-008 terms-only scope) is unchanged.",
            "before": "      termLabel.set(id, typeof term[\"rdfs:label\"] === \"string\" ? term[\"rdfs:label\"] : id);",
            "after": "      const tl = resolveLabel(term[\"rdfs:label\"]);\n      termLabel.set(id, tl.length > 0 ? tl : id);",
            "scope": "minimal"
          },
          {
            "id": "C14",
            "file": "src/emit/markdown.ts",
            "rationale": "Update term label extraction in the Terms section of emitMarkdown to handle {text, lang} object shape. Instance label extraction in the Instances section stays as plain string (ADR-008 terms-only scope).",
            "before": "      const label =\n        typeof t[\"rdfs:label\"] === \"string\"\n          ? t[\"rdfs:label\"]\n          : typeof t[\"id\"] === \"string\"\n          ? t[\"id\"]\n          : \"\";\n      if (label) lines.push(`- ${label}`);",
            "after": "      const rawTLabel = t[\"rdfs:label\"];\n      const label =\n        typeof rawTLabel === \"string\"\n          ? rawTLabel\n          : typeof rawTLabel === \"object\" &&\n            rawTLabel !== null &&\n            typeof (rawTLabel as Record<string, unknown>)[\"text\"] === \"string\"\n          ? ((rawTLabel as Record<string, unknown>)[\"text\"] as string)\n          : typeof t[\"id\"] === \"string\"\n          ? t[\"id\"]\n          : \"\";\n      if (label) lines.push(`- ${label}`);",
            "scope": "minimal"
          }
        ],
        "tests_recommended": [
          {
            "file": "tests/normalize-on-load.test.ts",
            "describe": "R4-3c: Add cases verifying normalizeLabelShape (plain->object, object->passthrough, malformed->empty); normalizeOnLoad with plain-string term labels sets wasNormalized:true and returns {text,lang} objects; second call on already-normalized doc returns wasNormalized:false."
          },
          {
            "file": "tests/legacy-migration.test.ts",
            "describe": "R4-3c: Add case verifying migrateV3toV4 coerces plain-string rdfs:label on ecm:terms to {text:...,lang:'en'}; report.transformedFields includes 'ecm:terms[*].rdfs:label'; already-shaped values pass through unchanged."
          },
          {
            "file": "tests/starter-terms.test.ts",
            "describe": "R4-3c: Update AC5 from typeof t['rdfs:label']==='string' to check t['rdfs:label'] is an object with non-empty .text string and .lang string."
          },
          {
            "file": "tests/emitters.test.ts",
            "describe": "R4-3c: Update MINIMAL_PROJECT fixture term rdfs:label from plain strings to {text,lang:'en'} objects; verify Turtle output contains language-tagged literals (@en) for term labels and plain literals for instance labels."
          }
        ],
        "open_questions": [
          "Language preservation in EditTermDialog (C10b): applyTermEdit always writes lang:'en'. If a term was originally authored with a different lang tag (e.g., 'fr'), editing it via EditTermDialog will silently overwrite the lang to 'en'. Should the dialog preserve the existing lang when the user does not explicitly change it? R4-3a defaults to 'en' per ADR-008 default; a future chain could add a lang-tag input field.",
          "Instance label scope (ADR-008 ambiguity, recon F29): This proposal follows ADR-008 strictly -- {text, lang} applies to ecm:terms entries only; ecm:Instance rdfs:label stays as plain string. SPEC 5.8 shows plain string; instance-label.spec.ts AC2 asserts toBe('Alice') which will continue to pass. If the operator later decides instances should also use {text, lang}, that requires a separate chain touching instance creation/edit paths plus the Playwright fixture and test.",
