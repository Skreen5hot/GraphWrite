          {
            "id": "C7",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "R4-TYPESYS-2: Render the 4th TermSection for Annotation Properties with data-testid='gw-term-section-annotation-properties', following existing section conventions. Inserted between Datatype Properties section and the addDialogType conditional.",
            "before": "      <TermSection\n        title=\"Datatype Properties\"\n        terms={datatypeProperties}\n        testId=\"gw-term-section-datatype-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setAddDialogType(\"owl:DatatypeProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-datatype-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n      />\n      {addDialogType !== null && project !== null && (",
            "after": "      <TermSection\n        title=\"Datatype Properties\"\n        terms={datatypeProperties}\n        testId=\"gw-term-section-datatype-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setAddDialogType(\"owl:DatatypeProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-datatype-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n      />\n      <TermSection\n        title=\"Annotation Properties\"\n        terms={annotationProperties}\n        testId=\"gw-term-section-annotation-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setAddDialogType(\"owl:AnnotationProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-annotation-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n      />\n      {addDialogType !== null && project !== null && (",
            "scope": "minimal"
          },
          {
            "id": "C8",
            "file": "src/ui/AddTermDialog.tsx",
            "rationale": "R4-TYPESYS-1: Add 'owl:AnnotationProperty' to AddTermType union so the Add dialog can create annotation-property terms. AddTermType is the upstream type source for the add-term flow (TermSidebar imports it).",
            "before": "export type AddTermType =\n  | \"owl:Class\"\n  | \"owl:ObjectProperty\"\n  | \"owl:DatatypeProperty\";",
            "after": "export type AddTermType =\n  | \"owl:Class\"\n  | \"owl:ObjectProperty\"\n  | \"owl:DatatypeProperty\"\n  | \"owl:AnnotationProperty\";",
            "scope": "minimal"
          },
          {
            "id": "C9",
            "file": "src/ui/AddTermDialog.tsx",
            "rationale": "Add 'owl:AnnotationProperty' entry to TERM_TYPE_LABEL so the dialog title and submit button read 'Annotation Property' for the new type.",
            "before": "const TERM_TYPE_LABEL: Record<AddTermType, string> = {\n  \"owl:Class\": \"Class\",\n  \"owl:ObjectProperty\": \"Object Property\",\n  \"owl:DatatypeProperty\": \"Datatype Property\",\n};",
            "after": "const TERM_TYPE_LABEL: Record<AddTermType, string> = {\n  \"owl:Class\": \"Class\",\n  \"owl:ObjectProperty\": \"Object Property\",\n  \"owl:DatatypeProperty\": \"Datatype Property\",\n  \"owl:AnnotationProperty\": \"Annotation Property\",\n};",
            "scope": "minimal"
          },
          {
            "id": "C10",
            "file": "src/emit/turtle.ts",
            "rationale": "SA4 fix: add dedicated rdfs:seeAlso handling in nodeToQuads(). When the value looks like an IRI (starts with http://, https://, urn:, or contains ':'), emit as namedNode; otherwise emit as literal. Previously rdfs:seeAlso was absent from both the IRI-valued and string-literal predicate loops, so zero quads were produced for it.",
            "before": "  // String-literal predicates\n  for (const pred of [\n    \"rdfs:label\", \"rdfs:comment\", \"ecm:format\", \"ecm:filename\",\n    \"ecm:contentHash\", \"ecm:generatedAt\",\n  ]) {\n    const val = node[pred];\n    if (typeof val === \"string\") {\n      result.push(makeQuad(subj, namedNode(expandIri(pred)), literal(val)));\n    }\n  }\n\n  // ecm:byteLength: number -> xsd:integer typed literal\n  const byteLen = node[\"ecm:byteLength\"];",
            "after": "  // String-literal predicates\n  for (const pred of [\n    \"rdfs:label\", \"rdfs:comment\", \"ecm:format\", \"ecm:filename\",\n    \"ecm:contentHash\", \"ecm:generatedAt\",\n  ]) {\n    const val = node[pred];\n    if (typeof val === \"string\") {\n      result.push(makeQuad(subj, namedNode(expandIri(pred)), literal(val)));\n    }\n  }\n\n  // rdfs:seeAlso: IRI-or-literal detection (SA4).\n  // Emit as a named node when the value looks like an IRI; otherwise as a literal.\n  const seeAlsoVal = node[\"rdfs:seeAlso\"];\n  if (typeof seeAlsoVal === \"string\") {\n    const isIri =\n      seeAlsoVal.startsWith(\"http://\") ||\n      seeAlsoVal.startsWith(\"https://\") ||\n      seeAlsoVal.startsWith(\"urn:\") ||\n      seeAlsoVal.includes(\":\");\n    result.push(makeQuad(\n      subj,\n      namedNode(expandIri(\"rdfs:seeAlso\")),\n      isIri ? namedNode(expandIri(seeAlsoVal)) : literal(seeAlsoVal),\n    ));\n  }\n\n  // ecm:byteLength: number -> xsd:integer typed literal\n  const byteLen = node[\"ecm:byteLength\"];",
            "scope": "minimal"
          },
          {
            "id": "C11",
            "file": "tests/starter-terms.test.ts",
