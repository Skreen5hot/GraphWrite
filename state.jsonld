      "outputs": {
        "findings": [
          {
            "id": "F1",
            "claim": "handleNew() in App.tsx accepts no parameters, calls buildNewDocument() directly with no user interaction, and immediately sets project state without opening any dialog.",
            "evidence": [
              {
                "file": "src/ui/App.tsx",
                "lines": "101-106",
                "excerpt": "function handleNew() {\n    const newDoc = buildNewDocument();\n    setProject(newDoc);\n    setValidationReport(validate(newDoc));\n    setMigrationBannerText(null);\n  }"
              },
              {
                "file": "src/ui/App.tsx",
                "lines": "21-39",
                "excerpt": "function buildNewDocument(): Record<string, unknown> {\n  return {\n    id: \"urn:ecm:project:new\",\n    type: [\"ecm:Project\", \"iao:OntologyDesignPattern\"],\n    \"ecm:specVersion\": \"0.4\",\n    \"ecm:name\": \"Untitled Project\",\n    ...\n    \"iao:isAbout\": [\"ecm:UnspecifiedSubjectMatter\"],\n  };\n}"
              }
