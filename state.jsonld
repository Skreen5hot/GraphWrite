            "claim": "ProjectSettingsDialog.tsx handleSave builds the updated project document and calls onSave(updated) (line 85); it does NOT call validate() internally \u00e2\u20ac\u201d all validation responsibility is delegated to the caller.",
            "evidence": [
              {
                "file": "src/ui/ProjectSettingsDialog.tsx",
                "lines": "70-86",
                "excerpt": "function handleSave(e: FormEvent<HTMLFormElement>) {\n    e.preventDefault();\n    const hasRealIri = isAbout.some((v) => v !== ECM_UNSPECIFIED);\n    const updated: Record<string, unknown> = { ...project, \"iao:isAbout\": isAbout };\n    if (hasRealIri) {\n      updated[\"ecm:_legacyAnchorPlaceholder\"] = undefined;\n    }\n    onSave(updated);\n  }"
              }
            ],
