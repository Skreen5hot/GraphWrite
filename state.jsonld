                "excerpt": "interface EcmInstance {\n  id: string;\n  type: \"ecm:Instance\";\n  ...\n}\nfunction isEcmInstance(v: unknown): v is EcmInstance {\n  ...\n  return (\n    typeof obj[\"id\"] === \"string\" &&\n    obj[\"type\"] === \"ecm:Instance\" &&\n    Array.isArray(obj[\"ecm:classIris\"])\n  );\n}"
              }
