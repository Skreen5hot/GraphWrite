          },
          {
            "id": "F11",
            "claim": "new-open-save.spec.ts AC2 clicks gw-btn-new and immediately awaits gw-btn-save to be enabled with no dialog interaction in between; this test flow will break if handleNew() opens a dialog before project state is set.",
            "evidence": [
              {
