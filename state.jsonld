      "outputs": {
        "findings": [
          {
            "id": "F1",
            "claim": "All four normative prefix-binding locations bind `iao:` to `http://purl.obolibrary.org/obo/iao#`, causing `iao:isAbout` to expand to `http://purl.obolibrary.org/obo/iao#isAbout` rather than the canonical IAO IRI `http://purl.obolibrary.org/obo/IAO_0000136`.",
            "evidence": [
              {
                "file": "project/SPEC.md",
                "lines": "297",
                "excerpt": "\"iao\": \"http://purl.obolibrary.org/obo/iao#\","
              },
              {
                "file": "src/kernel/canonicalize.ts",
                "lines": "72",
