          },
          {
            "id": "F10",
            "claim": "The ecm:Instance compact IRI expands to 'https://edgecanonical.org/ns/modeler#Instance' via PREFIX_MAP, so the rdf:type triple currently emitted for instance nodes in Turtle is <instance-iri> rdf:type <https://edgecanonical.org/ns/modeler#Instance>.",
            "evidence": [
              {
                "file": "src/emit/turtle.ts",
                "lines": "33-43",
                "excerpt": "const PREFIX_MAP: Record<string, string> = {\n  ecm: \"https://edgecanonical.org/ns/modeler#\",\n  ..."
              },
              {
                "file": "src/emit/turtle.ts",
                "lines": "49-54",
                "excerpt": "function expandIri(compact: string): string {\n  const colon = compact.indexOf(\":\");\n  if (colon <= 0) return compact;\n  const ns = PREFIX_MAP[compact.slice(0, colon)];\n  return ns !== undefined ? ns + compact.slice(colon + 1) : compact;\n}"
              }
            ],
            "kind": "inference"
          },
          {
            "id": "F11",
            "claim": "The upstream test run (all 130 tests, including emitters.test.js at 333ms) passed cleanly before this change, establishing the pre-change green baseline.",
            "evidence": [
              {
                "file": "UPSTREAM:urn:fnsr:task:466-test-r5-c4-v5",
                "lines": "N/A",
                "excerpt": "\"status\": \"all_pass\", \"passed\": 0, \"failed\": 0 ... \"Tests: 130/130 passed\""
