            "before": "      <p\n        style={{\n          fontSize: \"0.8rem\",\n          wordBreak: \"break-all\",\n          marginBottom: \"0.75rem\",\n        }}\n        data-testid=\"gw-inspector-subject\"\n      >\n        {rel[\"ecm:subjectIri\"]}\n      </p>",
