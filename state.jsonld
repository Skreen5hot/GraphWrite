          {
            "type": "source_file",
            "id": "src/projection/index.ts:31",
            "note": "SEMANTIC_TYPE_ALLOWLIST contains ecm:OntologyDesignPattern (not iao:OntologyDesignPattern), confirming ADR-007 is live in code"
          },
          {
