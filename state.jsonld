                "excerpt": "{project !== null && isAboutState !== \"clean\" && (\n  <div className={`gw-anchor-banner gw-anchor-banner--${isAboutState}`} ...>\n    ...\n    <button ... onClick={() => { setProjectSettingsOpen(true); }}>\n      {isAboutState === \"missing\" ? \"Set subject\" : \"Set real subject\"}\n    </button>\n  </div>\n)}"
