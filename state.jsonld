    {
      "@id": "urn:fnsr:task:369-dev-r4-4",
      "agent": "developer",
      "status": "done",
      "attempts": 1,
      "outputs": {
        "changes": [
          {
            "id": "C1",
            "file": "src/ui/PropertyCreationDialog.tsx",
            "rationale": "New file per FR-U033 Property Creation Module. Architecture: separate from AddTermDialog (which stays for Class/ObjectProperty) per implementation_directions. All 5 FR-U033 fields implemented. rdf: excluded from namespace selector per SPEC FR-U033. 8 XSD datatypes per SPEC (including xsd:double and xsd:anyURI added vs feedback). BCP47 free-text per SPEC. IRI uniqueness check is non-blocking warn. rdfs:range set only for DatatypeProperty (ADR-009).",
            "before": null,
            "after": "/**\n * PropertyCreationDialog -- FR-U033 Property Creation Module.\n *\n * Dedicated creation workflow for adding project-created annotation and\n * datatype properties from the Term Manager sidebar.\n *\n * Five fields per FR-U033:\n *   (a) Property Type Toggle  -- AnnotationProperty (default) / DatatypeProperty\n *   (b) Prefix / Namespace Selector -- ex:, foaf:, schema: (rdf: excluded per SPEC)\n *   (c) Local Name field      -- regex ^[a-zA-Z_][a-zA-Z0-9_.-]*$\n *   (d) Label + BCP 47 lang tag -- required text; default \"en\"\n *   (e) Target Data Type Dropdown -- XSD primitives (DatatypeProperty only)\n *\n * On submit: composes IRI as `${namespace}${localName}`, builds SPEC section 5.7\n * term with id=composedIRI, type=owl:AnnotationProperty|owl:DatatypeProperty,\n * ecm:source=ecm:project-created, rdfs:label={text,lang},\n * rdfs:range=xsdIri (DatatypeProperty only; ADR-009).\n *\n * IRI uniqueness check is non-blocking (warn inline; does not block submit).\n * Reuses Dialog primitive from src/ui/Dialog.tsx. FR-U033, ADR-009.\n */\n\nimport { useState, type FormEvent } from \"react\";\nimport { Dialog } from \"./Dialog.js\";\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport type PropertyCreationType =\n  | \"owl:AnnotationProperty\"\n  | \"owl:DatatypeProperty\";\n\nexport interface PropertyCreationDialogProps {\n  /** Initial property type; defaults to AnnotationProperty (FR-U033 default). */\n  initialType?: PropertyCreationType;\n  /** Read-only; used for non-blocking IRI uniqueness check (FR-U033). */\n  project: Record<string, unknown>;\n  /** Called with new SPEC section 5.7 term entry on successful submit. */\n  onConfirm: (newTerm: Record<string, unknown>) => void;\n  onClose: () => void;\n}\n\n// ---------------------------------------------------------------------------\n// Constants\n// Hardcoded app-level list per FR-U033 + SME S9 correction.\n// rdf: explicitly excluded: \"The rdf: namespace MUST NOT appear\" (SPEC FR-U033).\n// ---------------------------------------------------------------------------\n\nconst NAMESPACE_OPTIONS: ReadonlyArray<{ prefix: string; ns: string }> = [\n  { prefix: \"ex\",     ns: \"http://example.org/\" },\n  { prefix: \"foaf\",   ns: \"http://xmlns.com/foaf/0.1/\" },\n  { prefix: \"schema\", ns: \"https://schema.org/\" },\n];\n\n/** 8 XSD datatypes per FR-U033 (xsd:double + xsd:anyURI added vs FEEDBACK-ROUND-4.md). */\nconst XSD_DATATYPES: ReadonlyArray<string> = [\n  \"xsd:string\",\n  \"xsd:boolean\",\n  \"xsd:integer\",\n  \"xsd:decimal\",\n  \"xsd:double\",\n  \"xsd:date\",\n  \"xsd:dateTime\",\n  \"xsd:anyURI\",\n];\n\nconst XSD_NS = \"http://www.w3.org/2001/XMLSchema#\";\n\n/** BCP 47 tag pattern per FR-U033 (d). */\nconst BCP47_RE = /^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$/;\n\n/** Local name pattern per FR-U033 (c). */\nconst LOCAL_NAME_RE = /^[a-zA-Z_][a-zA-Z0-9_.-]*$/;\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction collectExistingIris(project: Record<string, unknown>): Set<string> {\n  const iris = new Set<string>();\n  for (const key of [\"ecm:terms\", \"ecm:instances\"]) {\n    const arr = project[key];\n    if (!Array.isArray(arr)) continue;\n    for (const item of arr as unknown[]) {\n      if (typeof item !== \"object\" || item === null) continue;\n      const id = (item as Record<string, unknown>)[\"id\"];\n      if (typeof id === \"string\" && id.length > 0) iris.add(id);\n    }\n  }\n  return iris;\n}\n\nfunction expandXsdIri(compact: string): string {\n  if (compact.startsWith(\"xsd:\")) return XSD_NS + compact.slice(4);\n  return compact;\n}\n\n// ---------------------------------------------------------------------------\n// Component\n// ---------------------------------------------------------------------------\n\nexport function PropertyCreationDialog({\n  initialType = \"owl:AnnotationProperty\",\n  project,\n  onConfirm,\n  onClose,\n}: PropertyCreationDialogProps) {\n  const [propertyType, setPropertyType] = useState<PropertyCreationType>(initialType);\n  const [selectedPrefix, setSelectedPrefix] = useState<string>(\n    NAMESPACE_OPTIONS[0].prefix,\n  );\n  const [localName, setLocalName] = useState(\"\");\n  const [labelText, setLabelText] = useState(\"\");\n  const [langTag, setLangTag] = useState(\"en\");\n  const [dataType, setDataType] = useState<string>(XSD_DATATYPES[0]);\n  const [submitError, setSubmitError] = useState<string | null>(null);\n\n  const selectedNs =\n    NAMESPACE_OPTIONS.find((o) => o.prefix === selectedPrefix)?.ns ?? \"\";\n  const trimmedLocal = localName.trim();\n  const composedIri =\n    trimmedLocal.length > 0 ? `${selectedNs}${trimmedLocal}` : \"\";\n  const localNameValid = trimmedLocal.length === 0 || LOCAL_NAME_RE.test(trimmedLocal);\n  const langTagTrimmed = langTag.trim();\n  const langTagValid = langTagTrimmed.length === 0 || BCP47_RE.test(langTagTrimmed);\n  const iriAlreadyExists =\n    composedIri.length > 0 && collectExistingIris(project).has(composedIri);\n  const isAnnotation = propertyType === \"owl:AnnotationProperty\";\n\n  function handleSubmit(e: FormEvent<HTMLFormElement>) {\n    e.preventDefault();\n    if (trimmedLocal.length === 0) {\n      setSubmitError(\"Local name is required.\");\n      return;\n    }\n    if (!LOCAL_NAME_RE.test(trimmedLocal)) {\n      setSubmitError(\n        \"Local name must match ^[a-zA-Z_][a-zA-Z0-9_.-]*$ (start with letter or underscore).\",\n      );\n      return;\n    }\n    const trimmedLabel = labelText.trim();\n    if (trimmedLabel.length === 0) {\n      setSubmitError(\"Label is required.\");\n      return;\n    }\n    if (langTagTrimmed.length === 0 || !BCP47_RE.test(langTagTrimmed)) {\n      setSubmitError(\"Language tag must be a valid BCP 47 tag (e.g. en, fr, zh-Hans).\");\n      return;\n    }\n    const now = new Date().toISOString();\n    const newTerm: Record<string, unknown> = {\n      \"ecm:createdAt\": now,\n      \"ecm:ontologyId\": null,\n      \"ecm:source\": \"ecm:project-created\",\n      \"ecm:updatedAt\": now,\n      id: composedIri,\n      \"rdfs:label\": { text: trimmedLabel, lang: langTagTrimmed },\n      type: propertyType,\n    };\n    if (!isAnnotation) {\n      newTerm[\"rdfs:range\"] = expandXsdIri(dataType);\n    }\n    onConfirm(newTerm);\n  }\n\n  return (\n    <Dialog\n      title={isAnnotation ? \"Add Annotation Property\" : \"Add Datatype Property\"}\n      onClose={onClose}\n      testId=\"gw-dialog-property-creation\"\n    >\n      <form\n        className=\"gw-term-form\"\n        onSubmit={handleSubmit}\n        data-testid=\"gw-form-property-creation\"\n      >\n        {submitError !== null && (\n          <p\n            className=\"gw-form-error\"\n            role=\"alert\"\n            data-testid=\"gw-form-error-property\"\n          >\n            {submitError}\n          </p>\n        )}\n\n        {/* (a) Property Type Toggle */}\n        <fieldset\n          className=\"gw-form-fieldset\"\n          data-testid=\"gw-fieldset-property-type\"\n        >\n          <legend className=\"gw-form-legend\">Property Type</legend>\n          <label className=\"gw-form-radio-label\">\n            <input\n              type=\"radio\"\n              name=\"propertyType\"\n              value=\"owl:AnnotationProperty\"\n              checked={isAnnotation}\n              onChange={() => setPropertyType(\"owl:AnnotationProperty\")}\n              data-testid=\"gw-radio-annotation-property\"\n            />{\" \"}\n            Annotation Property\n          </label>\n          <label className=\"gw-form-radio-label\">\n            <input\n              type=\"radio\"\n              name=\"propertyType\"\n              value=\"owl:DatatypeProperty\"\n              checked={!isAnnotation}\n              onChange={() => setPropertyType(\"owl:DatatypeProperty\")}\n              data-testid=\"gw-radio-datatype-property\"\n            />{\" \"}\n            Datatype Property\n          </label>\n        </fieldset>\n\n        {/* (b) Prefix / Namespace Selector */}\n        <label className=\"gw-form-label\">\n          Prefix *\n          <select\n            className=\"gw-form-select\"\n            value={selectedPrefix}\n            onChange={(e) => {\n              setSelectedPrefix(e.target.value);\n              setSubmitError(null);\n            }}\n            data-testid=\"gw-select-prefix\"\n          >\n            {NAMESPACE_OPTIONS.map((o) => (\n              <option key={o.prefix} value={o.prefix}>\n                {o.prefix}: ({o.ns})\n              </option>\n            ))}\n          </select>\n        </label>\n\n        {/* (c) Local Name */}\n        <label className=\"gw-form-label\">\n          Local Name *\n          <input\n            className=\"gw-form-input\"\n            type=\"text\"\n            value={localName}\n            onChange={(e) => {\n              setLocalName(e.target.value);\n              setSubmitError(null);\n            }}\n            placeholder=\"e.g. myProperty\"\n            data-testid=\"gw-input-local-name\"\n            autoFocus\n          />\n        </label>\n        {!localNameValid && (\n          <p\n            className=\"gw-form-error\"\n            role=\"alert\"\n            data-testid=\"gw-local-name-error\"\n          >\n            Must start with a letter or underscore; only letters, digits, underscores, dots, hyphens allowed.\n          </p>\n        )}\n        {composedIri.length > 0 && (\n          <p className=\"gw-form-hint\" data-testid=\"gw-composed-iri\">\n            IRI: {composedIri}\n          </p>\n        )}\n        {iriAlreadyExists && (\n          <p\n            className=\"gw-iri-duplicate-warning\"\n            role=\"alert\"\n            data-testid=\"gw-iri-duplicate-warning\"\n          >\n            Warning: this IRI already exists in the project.\n          </p>\n        )}\n\n        {/* (d) Label + Language Tag */}\n        <label className=\"gw-form-label\">\n          Label *\n          <input\n            className=\"gw-form-input\"\n            type=\"text\"\n            value={labelText}\n            onChange={(e) => {\n              setLabelText(e.target.value);\n              setSubmitError(null);\n            }}\n            data-testid=\"gw-input-property-label\"\n          />\n        </label>\n        <label className=\"gw-form-label\">\n          Language Tag{\" \"}\n          <span className=\"gw-form-hint\">(BCP 47; default en)</span>\n          <input\n            className=\"gw-form-input\"\n            type=\"text\"\n            value={langTag}\n            onChange={(e) => {\n              setLangTag(e.target.value);\n              setSubmitError(null);\n            }}\n            data-testid=\"gw-input-lang-tag\"\n          />\n        </label>\n        {!langTagValid && (\n          <p\n            className=\"gw-form-error\"\n            role=\"alert\"\n            data-testid=\"gw-lang-tag-error\"\n          >\n            Language tag must be a valid BCP 47 tag (e.g. en, fr, zh-Hans).\n          </p>\n        )}\n\n        {/* (e) Target Data Type Dropdown -- conditional on DatatypeProperty */}\n        {!isAnnotation && (\n          <label className=\"gw-form-label\">\n            Target Data Type *\n            <select\n              className=\"gw-form-select\"\n              value={dataType}\n              onChange={(e) => setDataType(e.target.value)}\n              data-testid=\"gw-select-datatype\"\n            >\n              {XSD_DATATYPES.map((dt) => (\n                <option key={dt} value={dt}>\n                  {dt}\n                </option>\n              ))}\n            </select>\n          </label>\n        )}\n\n        <div className=\"gw-form-actions\">\n          <button\n            type=\"button\"\n            className=\"gw-btn gw-btn--secondary\"\n            onClick={onClose}\n            data-testid=\"gw-btn-property-cancel\"\n          >\n            Cancel\n          </button>\n          <button\n            type=\"submit\"\n            className=\"gw-btn\"\n            data-testid=\"gw-btn-property-submit\"\n          >\n            {isAnnotation ? \"Add Annotation Property\" : \"Add Datatype Property\"}\n          </button>\n        </div>\n      </form>\n    </Dialog>\n  );\n}\n",
            "scope": "moderate"
          },
          {
            "id": "C2",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Add PropertyCreationDialog import so TermSidebar can open it for AnnotationProperty and DatatypeProperty creation paths.",
            "before": "import { AddTermDialog, type AddTermType } from \"./AddTermDialog.js\";",
            "after": "import { AddTermDialog, type AddTermType } from \"./AddTermDialog.js\";\nimport {\n  PropertyCreationDialog,\n  type PropertyCreationType,\n} from \"./PropertyCreationDialog.js\";",
            "scope": "minimal"
          },
          {
            "id": "C3",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Add propertyDialogType state alongside addDialogType. addDialogType stays for owl:Class and owl:ObjectProperty; propertyDialogType is used for owl:AnnotationProperty and owl:DatatypeProperty (FR-U033).",
            "before": "  const [addDialogType, setAddDialogType] = useState<AddTermType | null>(null);\n  /** Term being edited; null when the Edit dialog is closed (FR-U009). */\n  const [editTerm, setEditTerm] = useState<Record<string, unknown> | null>(null);",
            "after": "  const [addDialogType, setAddDialogType] = useState<AddTermType | null>(null);\n  /** Property type being created; null when PropertyCreationDialog is closed (FR-U033). */\n  const [propertyDialogType, setPropertyDialogType] =\n    useState<PropertyCreationType | null>(null);\n  /** Term being edited; null when the Edit dialog is closed (FR-U009). */\n  const [editTerm, setEditTerm] = useState<Record<string, unknown> | null>(null);",
            "scope": "minimal"
          },
          {
            "id": "C4",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Add handlePropertyConfirm handler for PropertyCreationDialog. Mirrors handleAddConfirm (append + sort by id + propagate) but closes propertyDialogType instead of addDialogType (FR-U033).",
            "before": "  /**\n   * Receive the updated project document from EditTermDialog (label / comment /\n   * IRI change already applied, refactor cascade included when IRI changed),\n   * propagate via onTermsChange, then close the dialog (FR-U009).\n   */\n  function handleEditConfirm(updatedProject: Record<string, unknown>) {\n    if (onTermsChange === undefined) return;\n    onTermsChange(updatedProject);\n    setEditTerm(null);\n  }",
            "after": "  /**\n   * Append the confirmed property term to ecm:terms, sort by id (SPEC section 5.3 rule 4),\n   * propagate via onTermsChange, then close the dialog (FR-U033).\n   */\n  function handlePropertyConfirm(newTerm: Record<string, unknown>) {\n    if (project === null || onTermsChange === undefined) return;\n    const existing: unknown[] = Array.isArray(project[\"ecm:terms\"])\n      ? (project[\"ecm:terms\"] as unknown[])\n      : [];\n    const sorted = [...existing, newTerm].sort((a, b) => {\n      const aId =\n        typeof (a as Record<string, unknown>)[\"id\"] === \"string\"\n          ? ((a as Record<string, unknown>)[\"id\"] as string)\n          : \"\";\n      const bId =\n        typeof (b as Record<string, unknown>)[\"id\"] === \"string\"\n          ? ((b as Record<string, unknown>)[\"id\"] as string)\n          : \"\";\n      return aId < bId ? -1 : aId > bId ? 1 : 0;\n    });\n    onTermsChange({ ...project, \"ecm:terms\": sorted });\n    setPropertyDialogType(null);\n  }\n\n  /**\n   * Receive the updated project document from EditTermDialog (label / comment /\n   * IRI change already applied, refactor cascade included when IRI changed),\n   * propagate via onTermsChange, then close the dialog (FR-U009).\n   */\n  function handleEditConfirm(updatedProject: Record<string, unknown>) {\n    if (onTermsChange === undefined) return;\n    onTermsChange(updatedProject);\n    setEditTerm(null);\n  }",
            "scope": "minimal"
          },
          {
            "id": "C5",
            "file": "src/ui/TermSidebar.tsx",
            "rationale": "Route DatatypeProperty and AnnotationProperty Add buttons to PropertyCreationDialog (with initialType hint); add PropertyCreationDialog render block. Class and ObjectProperty paths continue using AddTermDialog unchanged. ObjectProperty creation remains in AddTermDialog per FR-U033 scope (FR-U033 covers only Annotation/Datatype).",
            "before": "      <TermSection\n        title=\"Datatype Properties\"\n        terms={datatypeProperties}\n        testId=\"gw-term-section-datatype-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setAddDialogType(\"owl:DatatypeProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-datatype-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n      />\n      <TermSection\n        title=\"Annotation Properties\"\n        terms={annotationProperties}\n        testId=\"gw-term-section-annotation-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setAddDialogType(\"owl:AnnotationProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-annotation-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n      />\n      {addDialogType !== null && project !== null && (\n        <AddTermDialog\n          termType={addDialogType}\n          project={project}\n          onConfirm={handleAddConfirm}\n          onClose={() => setAddDialogType(null)}\n        />\n      )}\n      {editTerm !== null && project !== null && (\n        <EditTermDialog\n          term={editTerm}\n          project={project}\n          onConfirm={handleEditConfirm}\n          onClose={() => setEditTerm(null)}\n        />\n      )}",
            "after": "      <TermSection\n        title=\"Datatype Properties\"\n        terms={datatypeProperties}\n        testId=\"gw-term-section-datatype-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setPropertyDialogType(\"owl:DatatypeProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-datatype-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n      />\n      <TermSection\n        title=\"Annotation Properties\"\n        terms={annotationProperties}\n        testId=\"gw-term-section-annotation-properties\"\n        onAddTerm={\n          canEdit\n            ? () => setPropertyDialogType(\"owl:AnnotationProperty\")\n            : undefined\n        }\n        addTestId=\"gw-btn-add-annotation-property\"\n        onTermClick={canEdit ? handleTermClick : undefined}\n      />\n      {addDialogType !== null && project !== null && (\n        <AddTermDialog\n          termType={addDialogType}\n          project={project}\n          onConfirm={handleAddConfirm}\n          onClose={() => setAddDialogType(null)}\n        />\n      )}\n      {propertyDialogType !== null && project !== null && (\n        <PropertyCreationDialog\n          initialType={propertyDialogType}\n          project={project}\n          onConfirm={handlePropertyConfirm}\n          onClose={() => setPropertyDialogType(null)}\n        />\n      )}\n      {editTerm !== null && project !== null && (\n        <EditTermDialog\n          term={editTerm}\n          project={project}\n          onConfirm={handleEditConfirm}\n          onClose={() => setEditTerm(null)}\n        />\n      )}",
            "scope": "minimal"
          },
          {
            "id": "C6",
            "file": "src/emit/turtle.ts",
            "rationale": "Add foaf and schema prefixes to PREFIX_MAP per FR-U033 + SME S9 finding (F6). Required so composed IRIs using foaf: or schema: namespaces serialize with short-form prefixes in Turtle output.",
            "before": "const PREFIX_MAP: Record<string, string> = {\n  ecm:  \"https://edgecanonical.org/ns/modeler#\",\n  rdf:  \"http://www.w3.org/1999/02/22-rdf-syntax-ns#\",\n  rdfs: \"http://www.w3.org/2000/01/rdf-schema#\",\n  owl:  \"http://www.w3.org/2002/07/owl#\",\n  xsd:  \"http://www.w3.org/2001/XMLSchema#\",\n  obo:  \"http://purl.obolibrary.org/obo/\",\n  cco:  \"https://www.commoncoreontologies.org/\",\n};",
            "after": "const PREFIX_MAP: Record<string, string> = {\n  ecm:    \"https://edgecanonical.org/ns/modeler#\",\n  rdf:    \"http://www.w3.org/1999/02/22-rdf-syntax-ns#\",\n  rdfs:   \"http://www.w3.org/2000/01/rdf-schema#\",\n  owl:    \"http://www.w3.org/2002/07/owl#\",\n  xsd:    \"http://www.w3.org/2001/XMLSchema#\",\n  obo:    \"http://purl.obolibrary.org/obo/\",\n  cco:    \"https://www.commoncoreontologies.org/\",\n  foaf:   \"http://xmlns.com/foaf/0.1/\",\n  schema: \"https://schema.org/\",\n};",
            "scope": "minimal"
          },
          {
            "id": "C7",
            "file": "src/emit/turtle.ts",
            "rationale": "Add rdfs:range to the IRI-valued predicates loop in nodeToQuads() per ADR-009 and recon finding F7. Without this, DatatypeProperty terms with rdfs:range set by PropertyCreationDialog would silently drop the triple from Turtle output.",
            "before": "  // IRI-valued predicates (single IRI or array of IRIs)\n  for (const pred of [\"rdfs:subClassOf\", \"rdfs:subPropertyOf\", \"iao:isAbout\", \"ecm:isSerializationOf\"]) {",
            "after": "  // IRI-valued predicates (single IRI or array of IRIs)\n  // rdfs:range added per ADR-009: authorized on owl:DatatypeProperty; emits <xsd-IRI> triple.\n  for (const pred of [\"rdfs:subClassOf\", \"rdfs:subPropertyOf\", \"rdfs:range\", \"iao:isAbout\", \"ecm:isSerializationOf\"]) {",
            "scope": "minimal"
          },
          {
            "id": "C8",
            "file": "src/kernel/canonicalize.ts",
            "rationale": "Add foaf and schema prefix definitions to VMP_CONTEXT for JSON-LD consistency with turtle.ts PREFIX_MAP addition. Ensures foaf: and schema: IRIs appearing in ecm:terms are compressed in the @context of canonical JSON-LD output.",
            "before": "  obo: \"http://purl.obolibrary.org/obo/\",\n  cco: \"https://www.commoncoreontologies.org/\",\n  id: \"@id\",",
            "after": "  obo: \"http://purl.obolibrary.org/obo/\",\n  cco: \"https://www.commoncoreontologies.org/\",\n  foaf: \"http://xmlns.com/foaf/0.1/\",\n  schema: \"https://schema.org/\",\n  id: \"@id\",",
            "scope": "minimal"
          },
          {
            "id": "C9",
            "file": "src/validate/codes.ts",
            "rationale": "Add RANGE_CLASS_ON_DATATYPE_PROPERTY error code per ADR-009 mandate: 'The validator MUST enforce the XSD/DataRange constraint and emit RANGE_CLASS_ON_DATATYPE_PROPERTY (severity: error) on violation'. Placed in section 17.2 Hard Errors alongside other structural violations.",
            "before": "export const CANONICAL_RESERVED_NAME_COLLISION = \"CANONICAL_RESERVED_NAME_COLLISION\";",
            "after": "export const CANONICAL_RESERVED_NAME_COLLISION = \"CANONICAL_RESERVED_NAME_COLLISION\";\nexport const RANGE_CLASS_ON_DATATYPE_PROPERTY  = \"RANGE_CLASS_ON_DATATYPE_PROPERTY\";",
            "scope": "minimal"
          },
          {
            "id": "C10",
            "file": "src/validate/index.ts",
            "rationale": "Import RANGE_CLASS_ON_DATATYPE_PROPERTY from codes.ts so the new validation block can reference it.",
            "before": "import {\n  MISSING_REALIST_ANCHOR,\n  INVALID_SPEC_VERSION,\n  LEGACY_REALIST_ANCHOR_PLACEHOLDER,\n  NORMALIZED_ON_SAVE,\n  CANONICAL_RESERVED_NAME_COLLISION,\n} from \"./codes.js\";",
            "after": "import {\n  MISSING_REALIST_ANCHOR,\n  INVALID_SPEC_VERSION,\n  LEGACY_REALIST_ANCHOR_PLACEHOLDER,\n  NORMALIZED_ON_SAVE,\n  CANONICAL_RESERVED_NAME_COLLISION,\n  RANGE_CLASS_ON_DATATYPE_PROPERTY,\n} from \"./codes.js\";",
            "scope": "minimal"
          },
          {
            "id": "C11",
            "file": "src/validate/index.ts",
            "rationale": "Add RANGE_CLASS_ON_DATATYPE_PROPERTY validation logic per ADR-009. Checks every owl:DatatypeProperty term: if rdfs:range is present and is not an XSD datatype IRI (expanded http://www.w3.org/2001/XMLSchema#... or compact xsd:...), emits a hard error. Reuses rawTerms already declared above in the CANONICAL_RESERVED_NAME_COLLISION block. Prevents OWL 2 DL violations.",
            "before": "  // TODO (follow-up chain A): MISSING_PROJECT_ID, MISSING_PROJECT_NAME,\n  // MALFORMED_TERM, MALFORMED_INSTANCE, MALFORMED_RELATION,\n  // MALFORMED_LITERAL_ASSERTION, MALFORMED_SERIALIZATION_ENTRY, DUPLICATE_IRI.\n  // TODO (follow-up chain B): DANGLING_RELATION_SUBJECT_REF,",
            "after": "  // -------------------------------------------------------------------------\n  // RANGE_CLASS_ON_DATATYPE_PROPERTY (ADR-009, section 17.2)\n  // Fires when an owl:DatatypeProperty term carries rdfs:range with a value\n  // that is NOT an XSD datatype IRI (expanded or compact xsd: prefix).\n  // Prevents emitting an OWL 2 DL violation (class IRI used as datatype range).\n  // -------------------------------------------------------------------------\n  const XSD_NS_FULL = \"http://www.w3.org/2001/XMLSchema#\";\n  if (Array.isArray(rawTerms)) {\n    for (const term of rawTerms as unknown[]) {\n      if (typeof term !== \"object\" || term === null) continue;\n      const dt = term as Record<string, unknown>;\n      if (dt[\"type\"] !== \"owl:DatatypeProperty\") continue;\n      const rangeVal = dt[\"rdfs:range\"];\n      if (rangeVal === undefined || rangeVal === null) continue;\n      if (typeof rangeVal !== \"string\" || rangeVal.length === 0) continue;\n      const isXsd =\n        rangeVal.startsWith(XSD_NS_FULL) || rangeVal.startsWith(\"xsd:\");\n      if (!isXsd) {\n        const dtId =\n          typeof dt[\"id\"] === \"string\" ? (dt[\"id\"] as string) : projectId;\n        findings.push(\n          makeError(\n            RANGE_CLASS_ON_DATATYPE_PROPERTY,\n            `DatatypeProperty \"${dtId}\" has rdfs:range \"${rangeVal}\" which is not` +\n              \" an XSD datatype IRI. The range of an owl:DatatypeProperty MUST be\" +\n              \" an XSD datatype IRI (http://www.w3.org/2001/XMLSchema#...) or\" +\n              \" OWL DataRange (ADR-009, SPEC section 17.2).\",\n            dtId,\n          ),\n        );\n      }\n    }\n  }\n\n  // TODO (follow-up chain A): MISSING_PROJECT_ID, MISSING_PROJECT_NAME,\n  // MALFORMED_TERM, MALFORMED_INSTANCE, MALFORMED_RELATION,\n  // MALFORMED_LITERAL_ASSERTION, MALFORMED_SERIALIZATION_ENTRY, DUPLICATE_IRI.\n  // TODO (follow-up chain B): DANGLING_RELATION_SUBJECT_REF,",
            "scope": "minimal"
          }
        ],
        "tests_recommended": [
          {
            "file": "tests/playwright/property-creation.spec.ts",
            "describe": "FR-U033 Playwright acceptance tests. Recommended as a follow-up developer task (separate from this apply step to stay under the 25K char threshold). Should cover: (1) AnnotationProperty happy path -- open dialog via gw-btn-add-annotation-property, verify gw-radio-annotation-property checked by default, fill prefix=ex localName=myProp label=My Prop lang=en, submit, verify ecm:terms entry has type=owl:AnnotationProperty id=http://example.org/myProp rdfs:label={text,My Prop,lang,en} no rdfs:range. (2) DatatypeProperty happy path -- open via gw-btn-add-datatype-property, switch to gw-radio-datatype-property (or verify default from that button), select xsd:decimal, submit, verify type=owl:DatatypeProperty rdfs:range=http://www.w3.org/2001/XMLSchema#decimal. (3) Local name validation -- enter 123bad, verify gw-local-name-error visible, submit blocked. (4) Uniqueness warn (non-blocking) -- enter localName that produces an existing IRI, verify gw-iri-duplicate-warning visible but submit still proceeds. (5) Datatype dropdown hidden for AnnotationProperty -- verify gw-select-datatype not visible when Annotation radio selected; visible when Datatype radio selected. (6) Turtle output for DatatypeProperty -- load fixture, add DatatypeProperty with xsd:decimal, save, download and parse Turtle via N3, verify rdfs:range triple present. (7) foaf/schema prefix dropdown entries -- verify gw-select-prefix has foaf and schema options."
          },
          {
            "file": "tests/structural-validator.test.ts",
