            "after": "/** Ontology with skos:definition and skos:scopeNote on one owl:Class for AC8/AC9. */\nconst SKOS_TTL = [\n  \"@prefix owl:  <http://www.w3.org/2002/07/owl#> .\",\n  \"@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\",\n  \"@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\",\n  \"\",\n  \"<https://example.org/Concept> a owl:Class ;\",\n  '  rdfs:label \"Concept\"@en ;',\n  '  skos:definition \"A general notion or abstract idea.\"@en ;',\n  '  skos:scopeNote \"Use for abstract concepts only.\"@en .',\n  \"\",\n].join(\"\\n\");\n\n/** Independent SHA-256 reference hash of SMALL_TTL for AC4. */\nconst AC4_EXPECTED_HASH =\n  \"sha256-\" +\n  createHash(\"sha256\").update(Buffer.from(SMALL_TTL, \"utf8\")).digest(\"hex\");",
            "scope": "minimal"
