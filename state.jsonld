        "tests_recommended": [
          {
            "file": "tests/playwright/large-import-virtualization.spec.ts",
            "describe": "IMPL section 3.3 AC5: when a project has an ontology with ecm:importStatus='ecm:degraded' and a section contains >200 terms, assert data-testid='gw-term-section-virtualized' is present AND the count of li[data-testid='gw-term-item'] within it is <= 200 regardless of total term count. Also assert that when isDegraded is false (normal ontology), the attribute is absent and all terms render."
