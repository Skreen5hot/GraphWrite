            "file": "src/import/turtle-import.ts",
            "rationale": "Switch parser.parse() from the async-callback overload to the synchronous overload so quads[] is populated before the term-extraction loop runs. The synchronous form (no callback, returns Quad[]) is the known-working pattern already used in src/emit/n-triples.ts:35. The const\u00e2\u2020\u2019let change on quads is required by the reassignment. The surrounding try-catch now correctly catches synchronous parse errors thrown by the sync overload. Substance ratified at urn:fnsr:task:754-rat-p3-c1c; this re-emit anchors on pure-ASCII lines 140-153, omitting the mojibake-laden comment on line 139 which is unchanged by this fix.",
            "before": "  const parser = new Parser();\n  const quads: Quad[] = [];\n  try {\n    parser.parse(turtleSource, (err, quad) => {\n      if (err) throw err;\n      if (quad) quads.push(quad);\n    });\n  } catch (e) {\n    return {\n      ok: false,\n      error: `Turtle parse error: ${e instanceof Error ? e.message : String(e)}`,\n      code: \"PARSE_ERROR\",\n    };\n  }",
            "after": "  const parser = new Parser();\n  let quads: Quad[] = [];\n  try {\n    quads = parser.parse(turtleSource);\n  } catch (e) {\n    return {\n      ok: false,\n      error: `Turtle parse error: ${e instanceof Error ? e.message : String(e)}`,\n      code: \"PARSE_ERROR\",\n    };\n  }",
