@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/sample/Animal> a owl:Class ;
    rdfs:label "Animal"@en .

<https://example.org/sample/Dog> a owl:Class ;
    rdfs:label "Dog"@en ;
    rdfs:subClassOf <https://example.org/sample/Animal> .

<https://example.org/sample/Cat> a owl:Class ;
    rdfs:label "Cat"@en ;
    rdfs:subClassOf <https://example.org/sample/Animal> .

<https://example.org/sample/hasPet> a owl:ObjectProperty ;
    rdfs:label "has pet"@en .

<https://example.org/sample/petName> a owl:DatatypeProperty ;
    rdfs:label "pet name"@en ;
    rdfs:range xsd:string .
